# aide project configuration (personal — kept out of git by the global ignore)
AIDE_SPECS_PATH=/Users/ragnarwestad/develop/aide-specs/aide
# Run by the dashboard after a code merge (spec 96): install the scripts,
# refresh the dashboard's deps and restart its server where one runs.
AIDE_INSTALL_CMD=dashboard/deploy/install-after-merge.sh
# Both toolchains, because both can reach main: the root is pytest and
# dashboard/ is bun + TypeScript (.claude/rules/development.md). `make test`
# runs tsc --noEmit before bun test — a green `bun test` alone type-checks
# nothing, which is the whole reason that target exists.
# The PATH prefix is not decoration: the gate runs this through `bash -c`
# from the project root, and a non-login shell there has no mise shims —
# `make test` then fails on a missing `bun` rather than on a test, which
# would turn the gate into a refusal of everything. Same resolution
# dashboard/deploy/install-after-merge.sh already hardcodes for AIDE_DASH_BUN.
AIDE_TEST_SCOPE_PATHS_1=core tests
AIDE_TEST_SCOPE_CMD_1=export PATH="$HOME/.local/share/mise/shims:$PATH"; .venv/bin/pytest -q
AIDE_TEST_SCOPE_PATHS_2=dashboard
AIDE_TEST_SCOPE_CMD_2=export PATH="$HOME/.local/share/mise/shims:$PATH"; cd dashboard && make test
