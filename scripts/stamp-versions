#!/usr/bin/env bash
# stamp-versions - Stamp docs/AI_SUPPORT_MATRIX.md's "Supported versions"
# table from what the tools actually report, instead of hand-editing.
#
# For each tool that is on PATH, its row gets the probed version and
# today's date. A missing tool leaves its row untouched (with a warning) —
# the stamp records what was verified, never a guess.
#
# Usage:
#   scripts/stamp-versions [path-to-matrix]   # default: docs/AI_SUPPORT_MATRIX.md

set -e

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: scripts/stamp-versions [path-to-matrix]   # default: docs/AI_SUPPORT_MATRIX.md"
  exit 0
fi

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
MATRIX="${1:-$SCRIPT_DIR/../docs/AI_SUPPORT_MATRIX.md}"
source "$SCRIPT_DIR/../core/scripts/lib/ai-tools/read.sh"

if [ ! -f "$MATRIX" ]; then
  echo "❌ Matrix file not found: $MATRIX"
  exit 1
fi

TODAY="$(date +%F)"

# Probe a CLI and echo the first X.Y.Z-looking token, or nothing.
probe_version() {
  command -v "$1" >/dev/null 2>&1 || return 0
  "$1" --version 2>/dev/null | head -1 \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1
}

# Replace one table row: | <label> | <version> | <date> | <status kept> |
stamp_row() {
  local label="$1" version="$2" tmp
  if [ -z "$version" ]; then
    echo "⚠️  $label: tool not found on PATH — row left unchanged"
    return 0
  fi
  tmp="$(mktemp)"
  awk -v label="$label" -v version="$version" -v today="$TODAY" '
    BEGIN { FS = OFS = "|" }
    # A new value is padded to the cell width it replaces, so an aligned
    # table stays aligned.
    function cell(old, value,   w) {
      w = length(old) - 2
      if (w < length(value)) w = length(value)
      return sprintf(" %-" w "s ", value)
    }
    $2 ~ "^ *"label" *$" && NF >= 5 { $3 = cell($3, version); $4 = cell($4, today) }
    { print }
  ' "$MATRIX" > "$tmp" && mv "$tmp" "$MATRIX"
  echo "✅ $label: $version ($TODAY)"
}

ensure_row() {
  local label="$1" tmp
  awk -F'|' -v label="$label" '{ cell=$2; gsub(/^ +| +$/, "", cell); if (cell == label) found=1 } END { exit !found }' "$MATRIX" && return 0
  tmp="$(mktemp)"
  awk -v label="$label" '
    BEGIN { FS=OFS="|" }
    /^\|/ && $2 ~ /Tool/ { in_table=1; w2=length($2)-2; w3=length($3)-2; w4=length($4)-2; w5=length($5)-2 }
    in_table && /^$/ && !added {
      if (w2 < length(label)) w2=length(label)
      status="✅ Supported"; if (w5 < length(status)) w5=length(status)
      printf "| %-*s | %-*s | %-*s | %-*s |\n", w2,label,w3,"",w4,"",w5,status
      added=1
    }
    { print }
  ' "$MATRIX" > "$tmp" && mv "$tmp" "$MATRIX"
}

tool_ids="$(ai_tool_ids)" || exit 1
for id in $tool_ids; do
  label="$(ai_tool_field "$id" row)"
  cli="$(ai_tool_field "$id" cli)"
  version="$(probe_version "$cli")"
  [ -n "$version" ] && ensure_row "$label"
  stamp_row "$label" "$version"
done

echo ""
echo "Stamped: $MATRIX"
