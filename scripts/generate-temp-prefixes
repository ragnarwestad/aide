#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  -h|--help) echo "Usage: generate-temp-prefixes"; exit 0 ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/dashboard/src/serve/process-cleanup/temp-prefixes.generated.ts"
values="$(sed -nE 's/^AIDE_PYTEST_TEMP_PREFIX = "([^"]+)"/\1/p' "$root/core/tests/conftest.py")
$(sed -nE 's/^export const (BUN_TEST|LANDING_GATE|BOARD)_TEMP_PREFIX = "([^"]+)".*/\2/p' \
  "$root/dashboard/test/helpers/preload/private-tmpdir.ts" \
  "$root/dashboard/src/serve/land-branch/test-gate.ts" \
  "$root/dashboard/src/serve/setup/test-servers.ts")"
{
  echo '// Generated by scripts/generate-temp-prefixes from the sites that create these directories.'
  echo 'export const TEMP_PREFIXES = ['
  while IFS= read -r value; do [ -n "$value" ] && printf '  "%s",\n' "$value"; done <<< "$values"
  echo '] as const;'
} > "$out"
