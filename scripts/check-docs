#!/usr/bin/env bash
# check-docs - The guards that read the documentation, and nothing else.
#
# The tests that read a page rather than the code, where code depends on
# the text: the lifecycle diagram against `core/scripts/lib/transitions.json`,
# the skills' frontmatter, step headings and the script names they call,
# the templates' placeholders, and the dashboard's own docs guards. They
# live in both suites, which is why a doc change has no obvious command
# to run — this is that command.
#
# About ten seconds, against four minutes for both full suites. A change that
# also touches `dashboard/src` or `core/scripts` needs those:
#   .venv/bin/pytest -q              # the aide suite
#   cd dashboard && make test        # the dashboard suite
#
# Usage:
#   scripts/check-docs
set -o pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: scripts/check-docs"
  exit 0
fi

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

status=0

if [ -x .venv/bin/pytest ]; then
  .venv/bin/pytest -q tests/specs/unit/core/validation tests/specs/unit/core/skills || status=1
else
  echo "no .venv/bin/pytest — python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  status=1
fi

if command -v bun >/dev/null 2>&1; then
  ( cd dashboard && bun test test/guards test/design ) || status=1
else
  echo "bun is not installed — brew install oven-sh/bun/bun (see DEVELOPING.md)" >&2
  status=1
fi

exit "$status"
