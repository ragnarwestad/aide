#!/usr/bin/env bash
# check-bash - Run shellcheck over every bash script the repository tracks.
#
# The scripts are found through git: a tracked file named *.sh, or one whose
# first line is a shebang that runs bash. Nothing is listed by hand, so a new
# script is checked the moment it is committed. CI's shellcheck job runs this
# same file. The severity matches CI — warnings and errors fail, info and
# style do not.
# .shellcheckrc at the repo root is picked up automatically when run from
# there, which is why this script changes directory first.
#
# Usage:
#   scripts/check-bash

set -e

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "usage: scripts/check-bash"
  exit 0
fi

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "shellcheck is not installed — brew install shellcheck (see DEVELOPING.md, \"Tools you need\")" >&2
  exit 2
fi

cd "$(dirname "${BASH_SOURCE[0]}")/.."

git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || { echo "check-bash finds the scripts through git, and $(pwd) is not a git checkout" >&2; exit 2; }

scripts=()
while IFS= read -r -d '' file; do
  [ -f "$file" ] || continue
  case "$file" in
    *.sh) scripts+=("$file"); continue ;;
  esac
  first=""
  IFS= read -r first < "$file" || true
  case "$first" in
    '#!'*bash*) scripts+=("$file") ;;
  esac
done < <(git ls-files -z)

shellcheck --severity=warning "${scripts[@]}"
