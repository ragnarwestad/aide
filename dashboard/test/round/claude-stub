#!/usr/bin/env bash
# claude-stub — a stand-in for `claude -p` in the round `./run` drives.
#
# aide-run-spec starts it exactly as it starts the real CLI: the prompt on
# stdin, the flags on argv, the project worktree as cwd. It does the step
# the prompt names, deterministically and without a model, and prints one
# `result` event in the stream-json shape the runner parses. What it
# tests is everything AROUND the model: the queue, the worktrees, the
# push, the landing and the archive.
#
# Companion scripts (_aide-spec-lib.sh, aide-write-spec, aide-create-spec,
# aide-archive-spec, aide-record-test-run) come from the aide checkout
# the round was pointed at — $AIDE_ROUND_CHECKOUT, set by `./run` and
# inherited through the server's spawned child. Hand-piping a prompt
# through this script directly (no `./run` around it, as Step 1's own
# verification does) falls back to the checkout this script itself lives
# in, three directories up.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
AIDE_CHECKOUT="${AIDE_ROUND_CHECKOUT:-$(cd "$HERE/../../.." && pwd)}"
SCRIPTS="$AIDE_CHECKOUT/core/scripts"

session=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session="${2:-}"; shift 2 ;;
    --model|--max-budget-usd|--permission-mode|--output-format) shift 2 ;;
    *) shift ;;
  esac
done
prompt="$(cat)"

emit() { printf '%s\n' "$1"; }
# What the stand-in says a step cost. $0 everywhere but the one spec
# whose point is the cost: the queue checks the job cap BEFORE a step
# starts, so a cost that leaves no room for the next step's budget is
# what makes it stop the job there (runner.ts, startOne).
COST=0
ok() {
  emit "$(jq -cn --arg s "$session" --arg r "$1" --argjson c "$COST" \
    '{type:"result",subtype:"success",is_error:false,session_id:$s,total_cost_usd:$c,num_turns:1,result:$r}')"
  exit 0
}
fail() {
  emit "$(jq -cn --arg s "$session" --arg e "$1" \
    '{type:"result",subtype:"error_during_execution",is_error:true,session_id:$s,total_cost_usd:0,num_turns:1,errors:[$e],result:$e}')"
  exit 0
}
say() {
  emit "$(jq -cn --arg t "$1" '{type:"assistant",message:{role:"assistant",content:[{type:"text",text:$t}]}}')"
}

# shellcheck source=/dev/null
. "$SCRIPTS/_aide-spec-lib.sh"
BUN="${AIDE_ROUND_BUN:-$(command -v bun || echo "$HOME/.local/share/mise/shims/bun")}"

step="$(printf '%s' "$prompt" | sed -n 's#^/aide-\([a-z-]*\).*#\1#p' | head -1)"
[ -n "$step" ] || fail "claude-stub: the prompt does not name a step: $prompt"

if [ "$step" = "create" ]; then
  # The prompt aide-run-spec builds for a create step
  # (aide-run-spec:732-758) puts the description's OWN first line on the
  # same source line as `/aide-create TODO-<slug>`. Recovering the
  # description means stripping that prefix off line 1 as well as
  # reading every line up to (but not including) "Use exactly this
  # title" — not starting at line 2, which would silently drop the
  # description's own first line. The title line is the anchor, not a
  # blank line: a multi-paragraph description has blank lines of its
  # own between paragraphs, which a blank-line search would stop at
  # early and leave the rest of the description stuck in the title/
  # depends-on lines instead.
  title="$(printf '%s' "$prompt" | sed -n 's/^Use exactly this title for the spec: \(.*\)$/\1/p' | head -1)"
  depends="$(printf '%s' "$prompt" | sed -n 's/^Use exactly this Depends-on value in Tracking info: \(.*\)$/\1/p' | head -1)"
  first_line="$(printf '%s' "$prompt" | head -1 | sed -n 's#^/aide-create [^ ]* ##p')"
  rest="$(printf '%s' "$prompt" | sed -n '2,/^Use exactly this title/p' | sed '$d')"
  description="$(printf '%s\n%s' "$first_line" "$rest")"
  [ -n "$title" ] || fail "claude-stub: no title line in the create prompt: $prompt"

  specs_root="$(aide_config_get AIDE_SPECS_PATH .)"
  [ -n "$specs_root" ] || fail "claude-stub: no AIDE_SPECS_PATH in .aide/config"
  number="$(aide_next_spec_number "$specs_root")"
  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//')"
  say "claude-stub: create $number-$slug"
  args=(--specs-root "$specs_root" --number "$number" --slug "$slug" --title "$title" --description "$description")
  [ -n "$depends" ] && args+=(--depends-on "$depends")
  result="$("$SCRIPTS/aide-create-spec" "${args[@]}")" || fail "claude-stub: aide-create-spec refused"
  ok_flag="$(printf '%s' "$result" | jq -r .ok)"
  [ "$ok_flag" = "true" ] || fail "claude-stub: aide-create-spec refused: $(printf '%s' "$result" | jq -r '.error // .')"
  ok "created $(printf '%s' "$result" | jq -r .specFolder)"
fi

spec="$(printf '%s' "$prompt" | sed -n 's#^/aide-[a-z-]* \([^[:space:]]*\).*#\1#p' | head -1)"
specs_root="$(aide_config_get AIDE_SPECS_PATH .)"
[ -n "$specs_root" ] || fail "claude-stub: no AIDE_SPECS_PATH in .aide/config"
folder="$(aide_resolve_spec "$spec" "$specs_root")"
[ -n "$folder" ] && [ -d "$specs_root/$folder" ] || fail "claude-stub: unknown spec $spec under $specs_root"
slug="${folder##*/}"; slug="${slug#*-}"
say "claude-stub: $step on $folder"

write() {  # write <file> ; content on stdin
  "$SCRIPTS/aide-write-spec" --specs-root "$specs_root" --folder "${folder##*/}" --file "$1" >/dev/null \
    || fail "claude-stub: aide-write-spec refused $1"
}

status_file() {  # status_file <mark for phase 1> <mark for phase 2>
  cat <<STATUS
# $slug - Status

Total progress: 0% (0 of 2 completed)
Estimate: minutes

## Table of contents

1. [Tracking info](#tracking-info)
2. [Phase 1: RED](#phase-1-red)
3. [Phase 2: GREEN](#phase-2-green)
4. [Notation](#notation)

## Tracking info

- **Task:** \`${folder##*/}/\`
- **Last updated:** \`$(date -u +%Y-%m-%d)\`

## Phase 1: RED

| Task | Status | Notes |
|------|--------|-------|
| Write the failing test for the fact | $1 | |

## Phase 2: GREEN

| Task | Status | Notes |
|------|--------|-------|
| Add the fact to src/facts.ts | $2 | |

## Notation

- ⬜ Not started
- ✅ Completed
STATUS
}

# What each spec's implement does, keyed by slug. A fact goes onto the
# end of the array in src/facts.ts and a test looks for it. Two specs
# that both append at the end conflict when the second lands — that is
# the point of the second one.
fact_for() {
  case "$1" in
    add-the-first-fact) echo "the queue runs one job per spec at a time" ;;
    add-a-second-fact-to-the-same-file) echo "two branches that touch one line conflict when the second lands" ;;
    a-fact-that-depends-on-the-first) echo "a dependent spec waits until the dependency is archived" ;;
    a-test-that-stays-red) echo "" ;;
    an-unticked-acceptance-row) echo "an archive with an unticked acceptance row must not land" ;;
    a-landing-that-conflicts) echo "a conflict nobody resolves fails the landing" ;;
    an-archive-that-moves-nothing) echo "a step that says done without doing anything is caught" ;;
    a-step-that-costs-more-than-the-job-cap) echo "a job the cap stops is stopped, not failed" ;;
    a-step-that-runs-past-its-time-limit) echo "a step the clock ends is stopped, not failed" ;;
    a-step-that-writes-outside-its-own-folder) echo "a step writes only its own spec folder" ;;
    a-step-the-tool-could-not-finish) echo "a tool error fails the step and names the button" ;;
    *) echo "" ;;
  esac
}

append_fact() {  # append_fact <text>
  # Insert before the closing bracket, so every spec appends at the same
  # place and two of them collide.
  awk -v f="$1" '/^\];/ { print "  \"" f "\","; } { print }' src/facts.ts > src/facts.ts.new \
    && mv src/facts.ts.new src/facts.ts
}

# The section a real analyze writes into 4-status.md
# (core/skills/aide-analyze/references/requirements-tracing.md, step 8),
# so it lands on the default branch with analyze and the Checks tab can
# offer the row while implement's own work is still on its branch.
acceptance_section() {
  printf '\n## Acceptance criteria\n\n| Task | Status | Notes |\n|------|--------|-------|\n| REQ-1: a person has judged this | ⬜ | |\n'
}

write_test() {  # write_test <slug> <text expected>
  cat > "test/$1.test.ts" <<TEST
import { expect, test } from "bun:test";
import { facts } from "../src/facts.ts";

test("$1: the fact is on the list", () => {
  expect(facts).toContain("$2");
});
TEST
}

case "$step" in
  analyze)
    printf '# %s - Analysis\n\n## Summary\n\nOne fact goes onto the list in src/facts.ts, and one test looks for it.\nComplexity: LOW.\n' "$slug" | write 2-analysis.md
    printf '# %s - Solution\n\n## Plan\n\n1. Write the failing test.\n2. Append the fact.\n' "$slug" | write 3-solution.md
    { status_file "⬜" "⬜"
      case "$slug" in an-unticked-acceptance-row) acceptance_section ;; esac
    } | write 4-status.md
    # Analyze alone eats the room implement would need: the round's
    # config caps a job at $5 and gives each step $1, so $4.50 spent
    # here leaves the next step over the cap.
    [ "$slug" = "a-step-that-costs-more-than-the-job-cap" ] && COST=4.5
    ok "analyzed $folder"
    ;;
  implement)
    case "$slug" in
      analysis-only) fail "claude-stub: $slug has nothing to implement" ;;
      a-test-that-stays-red)
        write_test "$slug" "a fact nobody ever adds"
        status_file "✅" "⬜" | write 4-status.md
        ;;
      an-unticked-acceptance-row)
        fact="$(fact_for "$slug")"
        write_test "$slug" "$fact"
        append_fact "$fact"
        { status_file "✅" "✅"; acceptance_section; } | write 4-status.md
        ;;
      a-step-that-runs-past-its-time-limit)
        # The fixture gives this spec a 10s limit; the runner's own clock
        # ends the step (SIGTERM to the group) long before this returns.
        say "claude-stub: $slug sleeps past its time limit"
        sleep 120
        fail "claude-stub: $slug was not stopped by the time limit"
        ;;
      a-step-that-writes-outside-its-own-folder)
        fact="$(fact_for "$slug")"
        write_test "$slug" "$fact"
        append_fact "$fact"
        status_file "✅" "✅" | write 4-status.md
        # A note in a folder that is not this spec's — a new one, so it
        # is the same whichever fixtures have been archived by now. The
        # runner's specs guard discards it and fails the step
        # (run-spec-specs-guard.sh).
        mkdir -p "$specs_root/00-not-this-spec"
        printf '# A note that does not belong here\n' > "$specs_root/00-not-this-spec/5-note.md"
        ;;
      a-step-the-tool-could-not-finish)
        fail "the model's tool stopped with an error before it could finish"
        ;;
      *)
        fact="$(fact_for "$slug")"
        [ -n "$fact" ] || fail "claude-stub: no implement recipe for $slug"
        write_test "$slug" "$fact"
        append_fact "$fact"
        status_file "✅" "✅" | write 4-status.md
        ;;
    esac
    "$SCRIPTS/aide-record-test-run" --project-dir . --specs-root "$specs_root" --folder "${folder##*/}" \
      --cmd "$BUN test" >/dev/null 2>&1 || true
    ok "implemented $folder"
    ;;
  archive)
    # A merge left open is archive's to finish: keep both sides of the
    # one file the specs fight over, then commit. The tests are the
    # landing's to run, once, on the merged result — not this step's.
    for repo in . "$specs_root"; do
      top="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || continue
      if [ -f "$top/.git/MERGE_HEAD" ] || git -C "$top" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        say "claude-stub: resolving the open merge in $top"
        for f in $(git -C "$top" diff --name-only --diff-filter=U); do
          sed -e '/^<<<<<<< /d' -e '/^=======$/d' -e '/^>>>>>>> /d' "$top/$f" > "$top/$f.resolved" && mv "$top/$f.resolved" "$top/$f"
          git -C "$top" add "$f"
        done
        git -C "$top" -c core.editor=true commit --no-edit -q || fail "claude-stub: could not finish the merge in $top"
      fi
    done
    if [ "$slug" = "an-archive-that-moves-nothing" ]; then
      # aide-run-spec has already stamped and moved the folder before
      # this session runs (run-spec-spec-paths.sh, the mechanical
      # pre-check) — unless the step met an open merge, in which case it
      # left the folder alone. Either way the session below undoes every
      # uncommitted change in the specs worktree and still says done:
      # the folder is where it was, without an Archived stamp, and the
      # runner's own cross-check (run-spec-status-line.sh) turns the
      # claim into `no-progress`. The round's one "no real progress"
      # row, the same whichever way the pre-check went.
      name="${folder##*/}"
      ( cd "$specs_root" && git reset -q --hard HEAD && rm -rf "archive/$name" ) \
        || fail "claude-stub: could not put $name back"
      ok "archived $name"
    fi
    specs_dir="$(git -C "$specs_root" rev-parse --show-toplevel 2>/dev/null)"
    "$SCRIPTS/aide-archive-spec" --project-dir . --spec "$spec" --specs-dir "$specs_dir" >/dev/null 2>&1 || true
    if [ "$slug" = "a-landing-that-conflicts" ]; then
      # A COMPETING line on origin's main, landed behind this branch's
      # back once the step has done its own work — as if someone landed
      # by hand between the step and its landing. The step is clean; the
      # LANDING finds a conflict, every time: the round's one
      # deterministic failure, for the row's red to be seen (2026-09-11).
      # During the step itself it would be the runner's own merge that
      # met it, and that ends in `merge --abort` and "no progress".
      rival="$(mktemp -d)"
      git clone -q "$(git remote get-url origin)" "$rival/main" \
        && ( cd "$rival/main" \
             && awk -v f="someone landed this by hand, on the same line" '/^\];/ { print "  \"" f "\","; } { print }' src/facts.ts > src/facts.ts.new \
             && mv src/facts.ts.new src/facts.ts \
             && git -c user.name=rival -c user.email=rival@localhost commit -qam "land a competing fact by hand" \
             && git push -q origin main ) \
        || fail "claude-stub: could not land the rival fact on main"
      rm -rf "$rival"
    fi
    ok "archived $folder"
    ;;
  *)
    fail "claude-stub: step $step is not scripted"
    ;;
esac
