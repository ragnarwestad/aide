#!/usr/bin/env bash
# run — run the round through a throwaway dashboard.
#
# Builds, in a fresh temp directory, a local bare + working-copy pair for
# the fixture project and one for its specs, seeded from
# fixture-project/ and specs/, starts the dashboard FROM THE AIDE
# CHECKOUT GIVEN with that checkout's own aide-run-spec as the runner
# and the fixture project as its only project, presses the board's own
# Run (`POST /api/self-run`, which sends every fixture spec's
# description through create, waits for each to land a specFolder
# before the next, and queues that spec's own steps), waits for the
# queue to drain, and reports each spec's actual end state against what
# was expected.
# Nothing here touches the production dashboard, its files, or aide's
# own origin.
#
#   dashboard/test/round/run <aide checkout> [--port N] [--keep] [--timeout S] [--model NAME] [--branch NAME]
set -uo pipefail
AIDE="${1:-}"; shift || true
[ -n "$AIDE" ] && [ -f "$AIDE/dashboard/src/serve/serve.ts" ] \
  || { echo "usage: run <aide checkout> [--port N] [--keep] [--timeout S] [--model NAME] [--branch NAME]" >&2; exit 2; }
AIDE="$(cd "$AIDE" && pwd)"
PORT=8789; KEEP=no; TIMEOUT=900; MODEL=""; BRANCH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --keep) KEEP=yes; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    --model) MODEL="$2"; shift 2 ;;
    --branch) BRANCH="$2"; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
# Refused here, before WORK is ever created (mktemp is the next thing
# that runs): the round must not build anything for a branch that does
# not exist. A branch pushed only to origin (never fetched into this
# checkout) is not "does not exist" — spec 388, REQ-9 — so it is fetched
# and tracked locally before the refusal is decided.
#
# ALWAYS fetched, and the local branch moved to what origin has
# (2026-09-08). It used to fetch only when the local branch was missing,
# so a second round for the same branch served whatever that checkout
# happened to hold — an older tip, silently, while the dashboard's own
# registry said it was serving origin's. `-f` is refused while the
# branch is checked out in a worktree, and that is the one case where
# the local copy is the right one: a board is already running on it.
if [ -n "$BRANCH" ]; then
  git -C "$AIDE" fetch -q origin "$BRANCH" 2>/dev/null || true
  if git -C "$AIDE" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git -C "$AIDE" branch -q -f "$BRANCH" "origin/$BRANCH" 2>/dev/null ||
      git -C "$AIDE" branch -q "$BRANCH" "origin/$BRANCH" 2>/dev/null || true
  fi
  if ! git -C "$AIDE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    echo "no such branch: $BRANCH in $AIDE or its origin" >&2
    exit 2
  fi
fi
HERE="$(cd "$(dirname "$0")" && pwd)"
BUN="${AIDE_ROUND_BUN:-$(command -v bun || echo "$HOME/.local/share/mise/shims/bun")}"
BASE="http://127.0.0.1:$PORT"

WORK="$(mktemp -d)"
echo "== building local origins in $WORK"

SERVE_FROM="$AIDE"; WT=""; COMMIT=""
if [ -n "$BRANCH" ]; then
  # Self-heals a stale registration a killed or --keep'd prior round left
  # behind (a leftover elsewhere makes `worktree add` refuse this branch
  # even though the directory it once lived in is long gone).
  git -C "$AIDE" worktree prune >/dev/null 2>&1 || true
  WT="$WORK/checkout"
  if ! git -C "$AIDE" worktree add -q "$WT" "$BRANCH" 2>/dev/null; then
    # Reached here, WORK exists but `trap stop EXIT` is not registered yet
    # (that happens later, once the server is started) — clean up by hand
    # rather than leaking the temp directory on this one failure path.
    rm -rf "$WORK"
    echo "cannot check out $BRANCH in a worktree of $AIDE (it may already be checked out there, or in a leftover worktree)" >&2
    exit 1
  fi
  # `git worktree add` checks out TRACKED files only — dashboard/node_modules
  # is gitignored, so bun would otherwise find no dependencies at all in
  # the new worktree.
  mkdir -p "$WT/dashboard"
  ln -sfn "$AIDE/dashboard/node_modules" "$WT/dashboard/node_modules"
  SERVE_FROM="$WT"
  COMMIT="$(git -C "$SERVE_FROM" rev-parse --short HEAD 2>/dev/null)"
fi
# Spec 424: which spec this board serves, for the header's own Prod/Test
# line and its self-stop route. Only set when $BRANCH is — the prod
# launch path never passes --branch and never reaches this script.
SPEC_FOLDER="${BRANCH#aide/}"
# `--test-board` (spec 424) is an argument of the served checkout's OWN
# `serve.ts`, and a branch cut before that spec landed does not know it
# — handed the flag anyway, its serve refuses to start with "unknown
# argument". So the flag goes only where the branch's argument parser
# names it; an older branch gets the board it always got, without the
# header line and the Stop button.
# Every board the round starts is a TEST board (2026-09-10): it serves
# the round's own fixture specs and a stub model, whatever checkout it
# runs from. A branch names its spec; a plain checkout is named by its
# folder, which the header shows as just "Test".
TEST_BOARD_ARGS=()
if grep -q -- '--test-board' "$SERVE_FROM/dashboard/src/serve/serve-helpers/parse-args.ts" 2>/dev/null; then
  TEST_BOARD_ARGS=(--test-board "${SPEC_FOLDER:-$(basename "$SERVE_FROM")}")
fi

CODE_ORIGIN="$WORK/code-origin.git"; SPECS_ORIGIN="$WORK/specs-origin.git"
# `-b main`, never the machine's own `init.defaultBranch`: git makes
# `master` where nothing says otherwise, a clone of an empty origin takes
# that name with it, and the seeding push of `main` then fails with "src
# refspec main does not match any" — the same trap spec 345's cutover
# test fell into on a machine whose default branch is master.
git init -q --bare -b main "$CODE_ORIGIN"
git init -q --bare -b main "$SPECS_ORIGIN"

CODE="$WORK/code"; SPECS="$WORK/specs"
git clone -q "$CODE_ORIGIN" "$CODE"
cp -R "$HERE/fixture-project/." "$CODE/"
mkdir -p "$CODE/.aide"
# AIDE_SPECS_PATH is a fresh temp path every round, so this file is
# templated here rather than checked in (fixture-project/.gitignore
# keeps .aide/config out of the fixture project's own commit).
printf 'AIDE_SPECS_PATH=%s\nAIDE_TEST_CMD=%s test\n' "$SPECS" "$BUN" > "$CODE/.aide/config"
git -C "$CODE" -c user.name=round -c user.email=round@localhost add -A
git -C "$CODE" -c user.name=round -c user.email=round@localhost commit -qm "baseline"
git -C "$CODE" tag baseline
git -C "$CODE" push -q origin main --tags

git clone -q "$SPECS_ORIGIN" "$SPECS"
mkdir -p "$SPECS/archive"; touch "$SPECS/archive/.gitkeep"
git -C "$SPECS" -c user.name=round -c user.email=round@localhost add -A
git -C "$SPECS" -c user.name=round -c user.email=round@localhost commit -qm "start"
git -C "$SPECS" push -q origin main

echo "== preparing the board's own files"
mkdir -p "$WORK/site" "$WORK/jobs" "$WORK/checkouts" "$WORK/root"
ln -sfn "$CODE" "$WORK/root/aide-test"
# The same token every round, kept outside the throwaway directory. A
# fresh one per round meant a fresh link per round: the browser's cookie
# is scoped to the port (spec 363) and a new token invalidates it, so
# whoever was watching had to be handed a new URL every few minutes.
# `AIDE_ROUND_TOKEN` overrides it; the file is made once and reused.
TOKEN_FILE="${AIDE_ROUND_TOKEN_FILE:-$HOME/.aide-round-token}"
if [ -n "${AIDE_ROUND_TOKEN:-}" ]; then
  printf '%s' "$AIDE_ROUND_TOKEN" > "$WORK/token"
else
  [ -s "$TOKEN_FILE" ] || head -c 24 /dev/urandom | base64 | tr -d '/+=\n' > "$TOKEN_FILE"
  cat "$TOKEN_FILE" > "$WORK/token"
fi
TOKEN="$(cat "$WORK/token")"
# `concurrency` matches the serving board's own, so the queue behaves the
# way it does there: how many rows run at once, and which are held back,
# is the whole of what a round is watched for. The caps below are
# deliberately NOT the serving board's — they only stop a fixture spec
# costing real money, and cap nothing a reader looks at.
# `model` names every step, not `default` alone: the dashboard merges
# this table key by key over its own built-in one (QUEUE_DEFAULTS.model,
# src/serve/serve-helpers/config.ts), so a step named there and not here
# keeps the built-in model and the round stamps a real model on a run
# the stand-in performed.
cat > "$WORK/queue-config.json" <<CFG
{
  "budgetUsd": 1, "jobCapUsd": 5, "dailyCapUsd": 50,
  "timeoutSec": { "default": 600 },
  "permissionMode": { "default": "bypassPermissions" },
  "model": { "default": "script", "create": "script", "analyze": "script",
             "implement": "script", "archive": "script" },
  "modelChoices": { "script": { "budgetUsd": 1, "tool": "fake-claude" } },
  "push": "branch", "concurrency": 6,
  "projects": ["aide-test"]
}
CFG

# The stand-in by default, exactly as ~/develop/aide-test's own
# .aide/config used to point AIDE_CLAUDE_BIN at fake-claude — but this
# round's own config can no longer say so statically (the path is a
# fresh temp directory every time), so it is set here instead, and
# skipped only when a real model was named. AIDE_ROUND_CHECKOUT tells
# claude-stub which checkout's own companion scripts to call — the one
# this round is testing, which may not be the one `run` itself lives in.
export AIDE_ROUND_CHECKOUT="$SERVE_FROM"
if [ -n "$MODEL" ]; then
  tmp="$(mktemp)"
  jq --arg m "$MODEL" '.model.default = $m' "$WORK/queue-config.json" > "$tmp" && mv "$tmp" "$WORK/queue-config.json"
else
  export AIDE_CLAUDE_BIN="$HERE/claude-stub"
fi

echo "== starting the dashboard from $SERVE_FROM on :$PORT"
( cd "$SERVE_FROM/dashboard" && "$BUN" run src/main.ts generate --root "$WORK/root" --out "$WORK/site" \
    ${TEST_BOARD_ARGS[@]+"${TEST_BOARD_ARGS[@]}"} >/dev/null 2>&1 ) \
  || echo "(generate failed; serving without a generated site)"
( cd "$SERVE_FROM/dashboard" && exec "$BUN" run src/serve/serve.ts serve \
    --port "$PORT" --bind 127.0.0.1 --root "$WORK/root" --site "$WORK/site" \
    --queue-config "$WORK/queue-config.json" --queue-mirror "$WORK/queue.json" \
    --mirror "$WORK/runs.json" --result-dir "$WORK/jobs" --token-file "$WORK/token" \
    --dashboard-checkouts "$WORK/checkouts" --runner-bin "$SERVE_FROM/core/scripts/aide-run-spec" \
    --queue-projects aide-test ${TEST_BOARD_ARGS[@]+"${TEST_BOARD_ARGS[@]}"} ) > "$WORK/serve.log" 2>&1 &
SERVER=$!
# Removed on exit unless told to keep the board up — same shape
# test-instance's own stop()/trap already had.
stop() {
  if [ "$KEEP" = yes ] && kill -0 "$SERVER" 2>/dev/null; then
    if [ -n "$BRANCH" ]; then
      echo "left running: pid $SERVER, $BASE/?token=$TOKEN — serving $BRANCH @ $COMMIT (this board's specs are the round's own fixtures, not yours), $WORK"
      # $SERVER is already bun's own pid (the subshell above execs into
      # it), so `kill $SERVER` keeps working exactly as it does without a
      # branch — this watcher only adds cleanup for the worktree once
      # that same kill happens, whenever that turns out to be.
      ( while kill -0 "$SERVER" 2>/dev/null; do sleep 2; done
        git -C "$AIDE" worktree remove --force "$WT" >/dev/null 2>&1 || true
        git -C "$AIDE" worktree prune >/dev/null 2>&1 || true
        # And the board's own files with it (2026-09-08): the queue, the
        # jobs, the log and the token are of no use once the server they
        # belong to is gone, and a --keep'd round used to leave the whole
        # directory behind — 1900 of them had piled up in the machine's
        # temp by then.
        rm -rf "$WORK"
      ) >/dev/null 2>&1 &
      disown 2>/dev/null || true
    else
      echo "left running: pid $SERVER, $BASE/?token=$TOKEN, $WORK"
    fi
  else
    kill "$SERVER" 2>/dev/null; wait "$SERVER" 2>/dev/null
    if [ -n "$BRANCH" ]; then
      git -C "$AIDE" worktree remove --force "$WT" >/dev/null 2>&1 || true
      git -C "$AIDE" worktree prune >/dev/null 2>&1 || true
    fi
    rm -rf "$WORK"
  fi
}
trap stop EXIT

for _ in $(seq 1 40); do curl -s -m 2 -o /dev/null "$BASE/api/queue" -H "X-Aide-Token: $TOKEN" && break; sleep 0.5; done
curl -s -m 5 -o /dev/null -w '%{http_code}\n' "$BASE/api/queue" -H "X-Aide-Token: $TOKEN" | grep -q 200 \
  || { echo "the server did not come up; see $WORK/serve.log" >&2; tail -20 "$WORK/serve.log" >&2; exit 1; }
# The check above only proves SOMETHING answers on $PORT with the round's
# own token — the same value on purpose across every round (line ~106), so
# an older, --keep'd board answers it just as well as the one this round
# just started. A held port answers this instantly, before our own bun
# process has even finished loading its module graph to reach the
# Bun.serve() call that would throw EADDRINUSE and kill it (measured
# ~0.8s) — so a single kill -0 right here can catch a process that is
# about to die but has not yet. Give it a few seconds to reveal that
# before trusting it, and refuse as soon as it does.
alive=no
for _ in $(seq 1 6); do
  kill -0 "$SERVER" 2>/dev/null && alive=yes || { alive=no; break; }
  sleep 0.5
done
[ "$alive" = yes ] \
  || { echo "port $PORT is already held by another board — our own server (pid $SERVER) is not running; see $WORK/serve.log" >&2; exit 1; }

# The board answers from here on, and its specs appear one by one as each
# `create` below lands — so a reader waiting for it has something to look
# at minutes before the round is finished. The dashboard reads this line
# exactly as it reads the "left running" line at the end; the two say the
# same thing at different times. Printed only for a board that is being
# kept: a round that tears its own server down at the end has no address
# worth handing anybody.
if [ "$KEEP" = yes ] && [ -n "$BRANCH" ]; then
  echo "board up: pid $SERVER, $BASE/?token=$TOKEN — serving $BRANCH @ $COMMIT"
fi

api() { curl -s -m 60 -X POST "$BASE$1" -H "content-type: application/json" -H "accept: application/json" -H "X-Aide-Token: $TOKEN" -d "$2"; }

echo "== queue the specs, each through create"
# The board owns the round since 2026-09-11: `POST /api/self-run` puts
# the board back to its start and sends every fixture through create,
# waits for the folder each becomes, and queues that spec's own steps —
# the loop this script used to run itself. The Run button in the
# board's header presses the same endpoint, so a kept board can run the
# round again without a terminal. `GET /api/self-run` says how far the
# queueing has come and which folder each fixture became.
declare -a FOLDERS=() EXPECTS=()
fails=0
started="$(api /api/self-run '{}')"
printf '%s' "$started" | jq -e '.ok' >/dev/null \
  || { echo "  the board refused to start the round: $started" >&2; exit 1; }
round=""
for _ in $(seq 1 600); do
  round="$(curl -s -m 20 "$BASE/api/self-run" -H "accept: application/json" -H "X-Aide-Token: $TOKEN")"
  case "$(printf '%s' "$round" | jq -r .stage)" in
    running|done|failed) break ;;
  esac
  sleep 2
done
if [ "$(printf '%s' "$round" | jq -r .stage)" = "failed" ]; then
  echo "  the round did not get queued: $(printf '%s' "$round" | jq -r '.error // .stage')"
  fails=1
fi
# Bash 3.2: parallel arrays, no associative ones.
while IFS=$'\t' read -r slug folder expect; do
  [ -n "$folder" ] || { echo "  no folder for $slug"; fails=$((fails + 1)); continue; }
  FOLDERS+=("$folder"); EXPECTS+=("$expect")
done < <(printf '%s' "$round" | jq -r '.specs[] | [.slug, (.folder // ""), .expected] | @tsv')

echo "== wait for the queue to drain (up to ${TIMEOUT}s)"
start=$(date +%s)
while :; do
  jobs="$(curl -s -m 20 "$BASE/api/queue" -H "X-Aide-Token: $TOKEN")"
  # A queued archive held for the acceptance-criteria gate (spec 285) never
  # leaves "queued" on its own — nobody in this round ticks the row — so it
  # must not count as live, or the round burns the full TIMEOUT waiting for
  # a job that holds forever by design (spec 382, plan review must-fix 1).
  live="$(printf '%s' "$jobs" | jq '[.jobs[] | select((.state=="queued" and (.error.key != "runner.acceptanceCriteriaUnticked")) or .state=="running" or .landing==true)] | length')"
  [ "$live" = "0" ] && break
  # What the specs cron does on the production host every two minutes:
  # the local working copy follows origin. Without this, the queue's
  # own view of what is archived never catches up with what a landing
  # just pushed.
  git -C "$SPECS" pull -q --ff-only 2>/dev/null || true
  [ $(( $(date +%s) - start )) -ge "$TIMEOUT" ] && { echo "  timed out with $live job(s) still live"; break; }
  sleep 5
done

echo "== result"
git -C "$SPECS" fetch -q origin
archived_on_origin="$(git -C "$SPECS" ls-tree --name-only origin/main archive/ 2>/dev/null | sed 's#.*/##')"
open_code="$(git -C "$CODE" ls-remote --heads origin 'aide/*' | sed 's#.*refs/heads/##')"
open_specs="$(git -C "$SPECS" ls-remote --heads origin 'aide/*' | sed 's#.*refs/heads/##')"
i=0
while [ "$i" -lt "${#FOLDERS[@]}" ]; do
  folder="${FOLDERS[$i]}"; expect="${EXPECTS[$i]}"
  job="$(printf '%s' "$jobs" | jq -c --arg f "$folder" '[.jobs[] | select(.specFolder==$f)] | sort_by(.createdAt) | last')"
  state="$(printf '%s' "$job" | jq -r '.state // "no job"')"
  err="$(printf '%s' "$job" | jq -r '.error // empty' | cut -c1-90)"
  if printf '%s\n' "$archived_on_origin" | grep -qx "$folder"; then got=archived; else got=not-archived; fi
  branch=""; printf '%s\n' "$open_code $open_specs" | tr ' ' '\n' | grep -qx "aide/$folder" && branch=" (branch still on origin)"
  mark="ok"; [ "$got" = "$expect" ] || { mark="MISMATCH"; fails=$((fails + 1)); }
  printf '  %-8s %-42s job=%-9s %s%s%s\n' "$mark" "$folder" "$state" "$got" "$branch" "${err:+ — $err}"
  i=$((i + 1))
done

if [ -n "$MODEL" ]; then
  total_cost="$(printf '%s' "$jobs" | jq '[.jobs[].costUsd // 0] | add')"
  echo "== total cost: \$$total_cost (model: $MODEL)"
fi

echo "== log: $WORK/serve.log"
exit $(( fails > 0 ? 1 : 0 ))
