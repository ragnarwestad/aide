{
  "_comment": [
    "Which endings the dashboard words itself from the result's own fields, and which keep the",
    "runner's sentence.",
    "",
    "`aide-run-spec` asks board_words_ending (run-spec/publish/result.sh): when it answers yes the",
    "result carries the facts and `errorLog` and no `error` or `errorSolution`; when it answers no",
    "the result carries the runner's own `error` and `errorSolution`.",
    "The dashboard (Runner.complete, src/queue/runner/index.ts) words the same endings from the",
    "fields alone. Each case is a result without `error`: `terminalReason`, the `step` it ended",
    "in, and the fields the answer depends on (`timeLimit`, `sharedFiles`, `criteriaFaults`,",
    "`pushFailures`). `boardWords` is what both sides read."
  ],
  "cases": [
    {
      "name": "a red implement run",
      "step": "implement",
      "result": {
        "terminalReason": "tests-red",
        "testsRed": {
          "tests": ["a test"],
          "errors": ["boom"],
          "failed": 1,
          "total": 3
        }
      },
      "boardWords": true
    },
    {
      "name": "tests that never started",
      "step": "implement",
      "result": {
        "terminalReason": "tests-not-started",
        "testsNotStarted": { "kind": "test-command-unresolved" }
      },
      "boardWords": true
    },
    {
      "name": "a model that refused the turn",
      "step": "analyze",
      "result": { "terminalReason": "model-refused" },
      "boardWords": true
    },
    {
      "name": "an archive that left its merge open",
      "step": "archive",
      "result": { "terminalReason": "merge-unfinished" },
      "boardWords": true
    },
    {
      "name": "a write outside the spec folder",
      "step": "implement",
      "result": {
        "terminalReason": "scope-violation",
        "scopeViolation": "specs",
        "scopeSpecs": ["00-x/5-note.md"]
      },
      "boardWords": true
    },
    {
      "name": "an analyze that changed code",
      "step": "analyze",
      "result": {
        "terminalReason": "scope-violation",
        "scopeViolation": "analyze",
        "scopeAnalyze": {
          "project": { "committed": ["src/a.ts"], "uncommitted": [] },
          "phaseRows": false,
          "workflowSteps": false
        }
      },
      "boardWords": true
    },
    {
      "name": "a model at capacity",
      "step": "analyze",
      "result": {
        "terminalReason": "model-at-capacity",
        "modelId": "claude-sonnet-5"
      },
      "boardWords": true
    },
    {
      "name": "the AI tool failing",
      "step": "implement",
      "result": {
        "terminalReason": "cli-error",
        "tool": "claude",
        "providerError": { "kind": "login", "message": "Please run /login" }
      },
      "boardWords": true
    },
    {
      "name": "a short analysis over its limits",
      "step": "implement",
      "result": { "terminalReason": "short-analysis-over-limit" },
      "boardWords": true
    },
    {
      "name": "a spec sent back to a full analysis",
      "step": "implement",
      "result": { "terminalReason": "sent-back" },
      "boardWords": true
    },
    {
      "name": "a send-back that was refused",
      "step": "implement",
      "result": { "terminalReason": "sent-back-refused" },
      "boardWords": true
    },
    {
      "name": "a time limit the result names",
      "step": "analyze",
      "result": {
        "terminalReason": "timeout",
        "timeLimit": { "seconds": 600, "during": "session" }
      },
      "boardWords": true
    },
    {
      "name": "files other open specs share",
      "step": "analyze",
      "result": {
        "terminalReason": "shared-files",
        "sharedFiles": [{ "spec": "80-neighbour", "files": ["shared.ts"] }]
      },
      "boardWords": true
    },
    {
      "name": "an implement that changed nothing",
      "step": "implement",
      "result": { "terminalReason": "no-progress" },
      "boardWords": true
    },
    {
      "name": "an archive that changed nothing",
      "step": "archive",
      "result": { "terminalReason": "no-progress" },
      "boardWords": true
    },
    {
      "name": "a create that made no folder",
      "step": "create",
      "result": { "terminalReason": "no-progress" },
      "boardWords": true
    },
    {
      "name": "criteria faults the runner sorted: a criterion not in EARS form",
      "step": "analyze",
      "result": {
        "terminalReason": "acceptance-criteria",
        "criteriaFaults": {
          "missing": false,
          "notEars": ["AC-1"],
          "noScenario": [],
          "contradictions": [],
          "cannotBuild": []
        }
      },
      "boardWords": true
    },
    {
      "name": "criteria missing altogether",
      "step": "analyze",
      "result": {
        "terminalReason": "acceptance-criteria",
        "criteriaFaults": {
          "missing": true,
          "notEars": [],
          "noScenario": [],
          "contradictions": [],
          "cannotBuild": []
        }
      },
      "boardWords": true
    },
    {
      "name": "a push git refused",
      "step": "implement",
      "result": {
        "terminalReason": "unpushed",
        "pushFailures": [
          { "repo": "code", "branch": "aide/1-x", "kind": "auth" }
        ]
      },
      "boardWords": true
    },
    {
      "name": "a time limit with no limit named",
      "step": "analyze",
      "result": { "terminalReason": "timeout" },
      "boardWords": false
    },
    {
      "name": "shared files with no spec in the list",
      "step": "analyze",
      "result": { "terminalReason": "shared-files", "sharedFiles": [] },
      "boardWords": false
    },
    {
      "name": "an analyze that changed nothing",
      "step": "analyze",
      "result": { "terminalReason": "no-progress" },
      "boardWords": false
    },
    {
      "name": "a criteria fault the runner could not sort",
      "step": "analyze",
      "result": {
        "terminalReason": "acceptance-criteria",
        "criteriaFaults": {
          "missing": false,
          "notEars": [],
          "noScenario": [],
          "contradictions": [],
          "cannotBuild": []
        }
      },
      "boardWords": false
    },
    {
      "name": "a commit that failed with no push failure",
      "step": "implement",
      "result": { "terminalReason": "unpushed", "pushFailures": [] },
      "boardWords": false
    },
    {
      "name": "a usage limit",
      "step": "implement",
      "result": { "terminalReason": "provider-limit" },
      "boardWords": false
    },
    {
      "name": "a refusal before the step ran",
      "step": "implement",
      "result": { "terminalReason": "refused" },
      "boardWords": false
    }
  ]
}
