#!/bin/bash
# Upgrades all AI tools installed via mise
# Can be run manually or via cron (see .claude/rules/development.md)

export PATH="$HOME/.local/bin:$PATH"

echo "Upgrading AI tools via mise..."
mise upgrade gemini npm:@github/copilot npm:@openai/codex npm:@jetbrains/junie-cli opencode

echo ""
echo "Upgrading Claude Code (not managed by mise)..."
claude update

echo ""
echo "Installed versions:"
mise ls | grep -E "gemini|copilot|codex|junie|opencode"
claude --version
