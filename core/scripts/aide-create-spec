#!/usr/bin/env bash
# aide-create-spec — four Bash-only modes on the same file, all keeping
# specs-repo writes off the Write/Edit tool (see below): the mechanical
# step of /aide-create's Step 4 (spec 248), creating a spec's directory
# and its 5 files given specs-root/number/slug/title/description/
# depends-on; --folder-name, the same creation with no number or slug
# computed at all — a caller-given literal folder name, for a headless
# run whose real number is assigned later, at landing (spec 453);
# --assign-number, landing's own finalize step that renumbers such a
# folder in place once it is known to be the only one landing (spec
# 453); and --stamp-outcome, /aide-create's Step 5 patching an
# already-created 1-description.md's Tracking info with that phase's
# own Model/Time spent for an interactive run (spec 274) — the
# counterpart to aide-run-spec's own "outcome record" block, which only
# ever runs for a headless create.
#
# This is what lets file creation stay on a Bash-only path: before this
# script existed, /aide-create's Step 4 wrote the 5 files with the Write
# tool, which is indistinguishable, at the permission layer, from an AI
# assistant mistakenly hand-writing spec files outside any skill. Once
# this script is the only path a legitimate write takes, a Write/Edit
# permission rule can be scoped to the specs-repo path with no
# legitimate /aide-create case left to break.
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, specFolder?, files?}
#
# terminalReason: refused | created | stamped | assigned
#
# Usage:
#   aide-create-spec --specs-root <path> [--number <NN>] --slug <slug>
#                     --title <title> --description <text>
#                     [--depends-on <value>] [--result-file <path>]
#   aide-create-spec --specs-root <path> --folder-name <name>
#                     --title <title> --description <text>
#                     [--depends-on <value>] [--result-file <path>]
#   aide-create-spec --specs-root <path> --assign-number --folder <name>
#                     [--result-file <path>]
#   aide-create-spec --specs-root <path> --stamp-outcome --folder <NN-slug>
#                     --start-epoch <epoch-seconds> [--model <text>]
#                     [--result-file <path>]

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# `aide_next_spec_number` — the one place that answers "what is the next
# number", shared with every other caller so two answers cannot drift.
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"

specs_root=""; number=""; slug=""; title=""; description=""
depends_on=""; depends_on_given="no"; result_file=""
stamp_outcome="no"; folder=""; start_epoch=""; model=""
folder_name=""; assign_number="no"
# Whether this spec's Tracking info should say acceptance ticking is not
# required (spec 394). A bare flag, like --pull/--dry-run elsewhere:
# there is nothing to validate, and its absence is the byte-for-byte
# behaviour every caller before this flag existed already has (REQ-11).
acceptance_not_required="no"

while [ $# -gt 0 ]; do
  case "$1" in
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --number) number="${2:-}"; shift 2 ;;
    --slug) slug="${2:-}"; shift 2 ;;
    --title) title="${2:-}"; shift 2 ;;
    --description) description="${2:-}"; shift 2 ;;
    --depends-on) depends_on="${2:-}"; depends_on_given="yes"; shift 2 ;;
    --acceptance-not-required) acceptance_not_required="yes"; shift ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    --stamp-outcome) stamp_outcome="yes"; shift ;;
    --folder) folder="${2:-}"; shift 2 ;;
    --start-epoch) start_epoch="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --folder-name) folder_name="${2:-}"; shift 2 ;;
    --assign-number) assign_number="yes"; shift ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

# Same guard aide-archive-spec uses, before either helper below can be
# called — without it, a missing jq turns every refusal into a raw shell
# error instead of the one-JSON-line contract every caller relies on.
command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

refuse() {
  local msg="$1" line
  line="$(jq -cn --arg e "$msg" '{ok:false, exitCode:2, terminalReason:"refused", error:$e}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 2
}

emit_ok() {
  local extra="$1" line
  line="$(jq -cn --argjson extra "$extra" '{ok:true, exitCode:0} + $extra')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 0
}

[ -n "$specs_root" ] || refuse "missing --specs-root"

if [ "$stamp_outcome" = "yes" ]; then
  # Patches an already-created 1-description.md's Tracking info with this
  # phase's own Model/Time spent — the interactive counterpart to
  # aide-run-spec's own "outcome record" block (spec 245), which only
  # ever runs for a headless create. See core/skills/aide-create/SKILL.md
  # Step 5.
  [ -n "$folder" ] || refuse "missing --folder"
  [[ "$start_epoch" =~ ^[0-9]+$ ]] || refuse "missing or invalid --start-epoch"

  target=""
  for candidate in "$specs_root/$folder/1-description.md" \
                   "$specs_root/archive/$folder/1-description.md"; do
    [ -f "$candidate" ] && { target="$candidate"; break; }
  done
  [ -n "$target" ] || refuse "spec file not found: $folder/1-description.md"
  grep -q '^## Tracking info' "$target" || refuse "no Tracking info heading in $target"

  # AIDE_NOW_EPOCH: the clock a test hands in, so a span is exact rather
  # than one second either way on a busy host.
  elapsed=$(( ${AIDE_NOW_EPOCH:-$(date +%s)} - start_epoch ))
  [ "$elapsed" -ge 0 ] || refuse "--start-epoch is in the future"
  time_spent="$(printf '%dm%02ds' $(( elapsed / 60 )) $(( elapsed % 60 )))"

  block_file="$(mktemp)"
  [ -n "$model" ] && printf -- '- **Model:** %s\n' "$model" >> "$block_file"
  printf -- '- **Time spent:** %s\n' "$time_spent" >> "$block_file"

  # Idempotent, same shape as aide-run-spec's own Tracking-info insert
  # (core/scripts/aide-run-spec:2134-2148, whose file-based emit_block()
  # this mirrors): strip any existing Model/Time spent bullet from
  # inside the section, then insert fresh, right after the heading and
  # any blank line that follows it. The block is passed via a file
  # rather than a -v string, matching aide-run-spec's own pattern — the
  # macOS "one true awk" this repo targets (awk version 20200816) rejects
  # a literal newline inside a -v value ("newline in string ... at
  # source line 1"), which a -v-with-embedded-newline approach hits
  # immediately.
  awk -v block="$block_file" '
    function emit_block(  ln) { while ((getline ln < block) > 0) print ln; close(block) }
    /^## Tracking info/ {
      print; in_tracking = 1
      if ((getline nextline) > 0) {
        if (nextline ~ /^[ \t]*$/) { print nextline; emit_block() } else { held = nextline; has_held = 1; emit_block() }
      } else { emit_block() }
      # The held line still goes through the same strip filter a normal
      # in_tracking line would — a hand-edited file with no blank line
      # after the heading must not let a stale Model/Time-spent bullet
      # escape stripping just because it happened to be the lookahead.
      if (has_held && held !~ /^- \*\*(Model|Time spent):\*\*/) print held
      next
    }
    in_tracking && /^## / { in_tracking = 0 }
    in_tracking && /^- \*\*(Model|Time spent):\*\*/ { next }
    { print }
  ' "$target" > "$target.stamp-tmp" && mv "$target.stamp-tmp" "$target"
  rm -f "$block_file"

  emit_ok "$(jq -cn --arg f "$folder" '{terminalReason:"stamped", specFolder:$f}')"
fi

if [ "$assign_number" = "yes" ]; then
  # Landing's own finalize step (spec 453): a create job's folder exists
  # only under its literal provisional key (`new-<8 hex>`) until this
  # runs, under the specs repo's own merge lock, where two landings for
  # the same repo are already serialized by construction — the one place
  # two concurrent creates cannot collide over a number. Reuses
  # aide_next_spec_number/aide_slug_from_title, the same two functions
  # every other caller in this file already shares (spec 82's invariant:
  # one rule, one place) — never a second, hand-rolled count.
  [ -n "$folder" ] || refuse "missing --folder"
  src="$specs_root/$folder"
  [ -d "$src" ] || refuse "no such spec folder: $src"
  desc_file="$src/1-description.md"
  [ -f "$desc_file" ] || refuse "missing $desc_file"
  title_line="$(head -1 "$desc_file")"
  case "$title_line" in
    "# "*" - Description") title="${title_line#\# }"; title="${title% - Description}" ;;
    *) refuse "cannot read a title from $desc_file's first line: $title_line" ;;
  esac
  declare -f aide_next_spec_number >/dev/null 2>&1 \
    || refuse "_aide-spec-lib.sh is missing beside aide-create-spec — reinstall aide"
  number="$(aide_next_spec_number "$specs_root")"
  slug="$(aide_slug_from_title "$title")"
  new_folder="${number}-${slug}"
  dest="$specs_root/$new_folder"
  [ -d "$dest" ] && refuse "spec folder already exists: $dest"

  # Refuse loudly rather than leave a stale Task: line behind (the risk
  # a hand-edited Tracking info section would otherwise create): every
  # file that is supposed to carry the line is checked BEFORE anything
  # moves, so a refusal here leaves the folder exactly where it was.
  old_task_line="- **Task:** \`${folder}/\`"
  new_task_line="- **Task:** \`${new_folder}/\`"
  for name in 1-description.md 2-analysis.md 3-solution.md 4-status.md; do
    f="$src/$name"
    [ -f "$f" ] || continue
    grep -qF -- "$old_task_line" "$f" \
      || refuse "no '$old_task_line' line in $f — refusing rather than leave a stale Task: line after the rename"
  done

  git -C "$specs_root" mv "$folder" "$new_folder" || refuse "could not git mv $folder to $new_folder"

  for name in 1-description.md 2-analysis.md 3-solution.md 4-status.md; do
    f="$dest/$name"
    [ -f "$f" ] || continue
    awk -v old="$old_task_line" -v new="$new_task_line" \
      '{ if ($0 == old) print new; else print }' "$f" > "$f.assign-tmp" && mv "$f.assign-tmp" "$f"
  done

  # One commit, landing together with the merge that triggered it: the
  # rename alone (from `git mv`, already staged) plus the Task: line
  # rewrites above, which are not.
  git -C "$specs_root" add -- "$new_folder" \
    && git -C "$specs_root" commit -q -m "Assign $new_folder its number" \
    || refuse "could not commit the rename of $folder to $new_folder"

  emit_ok "$(jq -cn --arg f "$new_folder" '{terminalReason:"assigned", specFolder:$f}')"
fi

# --number is OPTIONAL: given, it is used as stated; omitted, this
# script picks it, and picking it HERE is what lets two creates run at
# once. Read-then-write from two sessions reads the same highest number
# and writes the same folder — which is why the round had to send its
# fixture specs one at a time. `mkdir` settles it instead: the loser of
# the race takes the next free number and tries again.
#
# --folder-name is a THIRD shape, for a headless run whose real number
# is not decided here at all any more (spec 453): the caller already
# has a unique name (the job's own provisional key), so there is
# nothing to race over and no lock to take — `--number`'s validation
# and the auto-pick lock below are both skipped entirely.
[ -n "$folder_name" ] || [ -n "$slug" ] || refuse "missing --slug"
[ -n "$title" ] || refuse "missing --title"
[ -n "$description" ] || refuse "missing --description"

# The rule's own definition of an acceptance-criteria line
# (core/rules/spec-structure.md § 1-description) is
# `^- \*\*AC-\d+:\*\*`. Detected by stripping every `*` from the line
# and checking for a bare "- AC-n:" shape underneath — this catches
# any placement of the bold markers (missing entirely, or just
# misplaced), not only the one exact shape already seen once. A line
# that survives stripping unmatched is ordinary text and is never
# touched.
while IFS= read -r ac_line; do
  stripped="${ac_line//\*/}"
  case "$stripped" in
    "- AC-"[0-9]*":"*)
      case "$ac_line" in
        "- **AC-"[0-9]*":**"*) : ;;
        *) refuse "Acceptance criteria line does not match the required '- **AC-n:** ...' format: \"$ac_line\"" ;;
      esac
      ;;
  esac
done <<AC_CHECK_EOF
$description
AC_CHECK_EOF

if [ -n "$folder_name" ]; then
  [[ "$folder_name" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || refuse "invalid --folder-name: $folder_name"
  folder="$folder_name"
  dest="$specs_root/$folder"
  [ -d "$dest" ] && refuse "spec folder already exists: $dest"
elif [ -n "$number" ]; then
  # A number handed in must lie above every number already there — a
  # spec number is never reused, and a caller
  # that counted wrong — a session that sorted the archive's folder
  # names alphabetically and read "99-…" as the highest, then asked for
  # 100, which an archived spec already had (2026-09-10) — must be
  # refused, not obeyed. Skipped only where the helper is missing, so a
  # bare copy of the script still creates what it is asked to.
  if declare -f aide_next_spec_number >/dev/null 2>&1; then
    expected="$(aide_next_spec_number "$specs_root")"
    highest="$(( 10#$expected - 1 ))"
    if [ "$((10#$number))" -le "$highest" ]; then
      refuse "spec number $number is already taken — the highest under $specs_root (and its archive/) is $highest, so the next is $expected"
    fi
  fi
  folder="${number}-${slug}"
  dest="$specs_root/$folder"
  [ -d "$dest" ] && refuse "spec folder already exists: $dest"
else
  declare -f aide_next_spec_number >/dev/null 2>&1 \
    || refuse "_aide-spec-lib.sh is missing beside aide-create-spec — reinstall aide, or pass --number"
  # The lock has to be on the NUMBER, not on the folder: two creates
  # with different slugs make different directories at the same number,
  # so `mkdir "$dest"` locks nothing. `mkdir` of one shared name does —
  # it is atomic, and it fails for whoever is second.
  #
  # Held for the few milliseconds it takes to read the highest number
  # and make the folder, which is what has to be indivisible. Removed on
  # every exit path below, and broken when it is older than a minute:
  # a run killed mid-claim must not stop every later one.
  lock="$specs_root/.aide-create.lock"
  claimed=""
  for _ in $(seq 1 100); do
    if mkdir "$lock" 2>/dev/null; then
      number="$(aide_next_spec_number "$specs_root")"
      folder="${number}-${slug}"
      dest="$specs_root/$folder"
      if [ -d "$dest" ]; then
        rmdir "$lock" 2>/dev/null
        refuse "spec folder already exists: $dest"
      fi
      mkdir "$dest" 2>/dev/null || { rmdir "$lock" 2>/dev/null; refuse "could not create $dest"; }
      rmdir "$lock" 2>/dev/null
      claimed="yes"
      break
    fi
    # A lock nobody is holding any more: whoever made it is gone.
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rmdir "$lock" 2>/dev/null
    fi
    sleep 0.1
  done
  [ -n "$claimed" ] || refuse "could not claim a spec number under $specs_root — $lock is held"
fi

today="$(date -u +%Y-%m-%d)"

depends_line=""
if [ "$depends_on_given" = "yes" ] && [ -n "$depends_on" ]; then
  # paste -sd cycles through a multi-character delimiter one character
  # per join, rather than repeating the whole string — so ", " would
  # come out as a bare "," between every pair. Joined with a single
  # comma instead, then widened to ", " afterwards.
  formatted="$(printf '%s' "$depends_on" | tr ',' '\n' \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' \
    | sed 's/^/`/; s/$/`/' | paste -sd, - | sed 's/,/, /g')"
  [ -n "$formatted" ] && depends_line=$'\n- **Depends on:** '"$formatted"
fi

accept_line=""
[ "$acceptance_not_required" = "yes" ] && accept_line=$'\n- **Acceptance:** not required'

# Already made above when this run claimed its own number; `-p` is what
# makes that case a no-op rather than a second, failing create.
mkdir -p "$dest" || refuse "could not create $dest"

# The heredoc delimiter below is deliberately unquoted (<<AIDE_EOF, not
# <<'AIDE_EOF') so ${title}/${folder}/${today}/${depends_line}/
# ${description} are substituted. This is safe: bash performs parameter
# expansion exactly once, over the heredoc's own literal template text —
# a substituted value is inserted as data and is never re-scanned for
# further expansion. A description containing backticks or $(...) is
# written out verbatim, not executed (the same reason
# `x='$(cmd)'; echo "$x"` prints text instead of running cmd — bash does
# not double-evaluate; eval exists precisely because ordinary
# substitution never does this). Literal backticks that belong to the
# template itself (not to a substituted value) are escaped as \` so an
# unquoted heredoc does not read them as command substitution.

cat > "$dest/0-README.md" <<AIDE_EOF
# Documentation

## Table of contents

1. [Description](1-description.md) - Tracking info and the problem
2. [Analysis](2-analysis.md) - Mapping and findings
3. [Solution](3-solution.md) - Scope, plan, criteria and risk
4. [Status](4-status.md) - Progress tracking
AIDE_EOF

cat > "$dest/1-description.md" <<AIDE_EOF
# ${title} - Description

## Table of contents

- [Tracking info](#tracking-info)
- [Description](#description)

---

## Tracking info

- **Task:** \`${folder}/\`
- **Created:** \`${today}\`${depends_line}${accept_line}

---

## Description

${description}

*This description can be edited before /aide-analyze runs.*
AIDE_EOF

aide_write_placeholder_files "$dest" "$title" "$folder"

emit_ok "$(jq -cn --arg f "$folder" --argjson files '["0-README.md","1-description.md","2-analysis.md","3-solution.md","4-status.md"]' \
  '{terminalReason:"created", specFolder:$f, files:$files}')"
