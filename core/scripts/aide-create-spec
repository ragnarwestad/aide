#!/usr/bin/env bash
# aide-create-spec — Bash-only modes on the same file, all keeping
# specs-repo writes off the Write/Edit tool. Creating a spec's directory
# and its 5 files: with --folder-name, under the literal folder name the
# board gives a create step, whose real number is assigned later, at
# landing; without it, for the board's direct create, under the next
# number and a slug made from the title. And --assign-number, landing's
# own finalize step that renumbers a literally-named folder in place
# once it is known to be the only one landing.
#
# File creation stays on a Bash-only path, so a Write/Edit permission
# rule can be scoped to the specs-repo path with no legitimate create
# left to break.
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, specFolder?, files?}
#
# terminalReason: refused | created | assigned
#
# Usage:
#   aide-create-spec --specs-root <path> [--folder-name <name>]
#                     --title <title> --description <text>
#                     [--given-description <text>]
#                     [--depends-on <value>] [--result-file <path>]
#   aide-create-spec --specs-root <path> --assign-number --folder <name>
#                     [--result-file <path>]

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
aide_create_spec_usage() {
  printf '%s\n' 'Usage:' \
    '  aide-create-spec --specs-root <path> [--folder-name <name>]' \
    '                    --title <title> --description <text>' \
    '                    [--given-description <text>]' \
    '                    [--depends-on <value>] [--result-file <path>]' \
    '  aide-create-spec --specs-root <path> --assign-number --folder <name>' \
    '                    [--result-file <path>]'
}
# Kept in each spec command, not sourced: it runs with nothing loaded, so
# --help answers and a missing library is refused into --result-file.
bootstrap_result_file=""
bootstrap_value=""
for arg in "$@"; do
  if [ -n "$bootstrap_value" ]; then
    [ "$bootstrap_value" = "result" ] && bootstrap_result_file="$arg"
    bootstrap_value=""
    continue
  fi
  case "$arg" in
    -h|--help) aide_create_spec_usage; exit 0 ;;
    --result-file) bootstrap_value="result" ;;
    --specs-root|--title|--description|--given-description|--depends-on|--folder|--folder-name) bootstrap_value="value" ;;
  esac
done
require_library() {
  [ -f "$SCRIPT_DIR/$1" ] && return 0
  payload="$(printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"%s is missing beside aide-create-spec — reinstall aide"}' "$1")"
  printf '%s\n' "$payload"
  [ -z "$bootstrap_result_file" ] || printf '%s\n' "$payload" > "$bootstrap_result_file"
  exit 2
}
require_library "_aide-spec-lib.sh"
require_library "lib/config/aide-config.sh"
require_library "lib/spec-result.sh"
require_library "lib/spec-reference.sh"
require_library "lib/tracking-info.sh"
require_library "lib/create-spec/create.sh"
require_library "lib/create-spec/assign-number.sh"
# `aide_next_spec_number` — the one place that answers "what is the next
# number", shared by a create without --folder-name and --assign-number.
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_aide-spec-lib.sh"
source "$SCRIPT_DIR/lib/spec-result.sh"
source "$SCRIPT_DIR/lib/spec-reference.sh"
source "$SCRIPT_DIR/lib/create-spec/create.sh"
source "$SCRIPT_DIR/lib/create-spec/assign-number.sh"

specs_root=""; title=""; description=""
depends_on=""; depends_on_given="no"; result_file=""
folder=""
folder_name=""; assign_number="no"
# Whether this spec's Tracking info should say acceptance ticking is not
# required. A bare flag, like --pull/--dry-run elsewhere:
# there is nothing to validate, and its absence is the byte-for-byte
# behaviour every caller before this flag existed already has.
acceptance_not_required="no"
criteria_checks=""; choose_approach=""
# The description as the create step received it, before it added criteria.
# A flag of its own, so an empty value still counts as given.
given_description=""; given_set="no"

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) aide_create_spec_usage; exit 0 ;;
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --title) title="${2:-}"; shift 2 ;;
    --description) description="${2:-}"; shift 2 ;;
    --given-description) given_description="${2:-}"; given_set="yes"; shift 2 ;;
    --depends-on) depends_on="${2:-}"; depends_on_given="yes"; shift 2 ;;
    --acceptance-not-required) acceptance_not_required="yes"; shift ;;
    --criteria-checks) criteria_checks="${2:-}"; shift 2 ;;
    --choose-approach) choose_approach="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    --folder) folder="${2:-}"; shift 2 ;;
    --folder-name) folder_name="${2:-}"; shift 2 ;;
    --assign-number) assign_number="yes"; shift ;;
    *) aide_spec_refuse "unknown argument: $1" ;;
  esac
done

# Same guard aide-archive-spec uses, before either helper below can be
# called — without it, a missing jq turns every refusal into a raw shell
# error instead of the one-JSON-line contract every caller relies on.
command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

# shellcheck source=/dev/null
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/tracking-info.sh"

[ -n "$specs_root" ] || aide_spec_refuse "missing --specs-root"

case "$criteria_checks" in ""|off|warn|stop) ;; *) aide_spec_refuse "invalid --criteria-checks: $criteria_checks (off, warn or stop)" ;; esac
case "$choose_approach" in ""|yes|no) ;; *) aide_spec_refuse "invalid --choose-approach: $choose_approach (yes or no)" ;; esac

if [ "$assign_number" = "yes" ]; then
  aide_create_spec_assign_number
fi

aide_create_spec_create
exit 0
