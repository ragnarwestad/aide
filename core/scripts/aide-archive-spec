#!/usr/bin/env bash
# aide-archive-spec — the mechanical steps of /aide-archive (spec 251):
# resolving the spec argument to a folder, checking whether a merge
# conflict is open, reading 4-status.md's Tasks tables to decide whether
# the work is done, and (when it is) stamping and moving the folder.
#
# Only two things here need a model's judgment, and neither is this
# script's job: resolving an actual merge conflict, and deciding what
# documentation should outlive the spec (Step 4 of the skill). Every
# other archive run used to spend a full AI session reasoning about
# 4-status.md's tables by hand, purely to conclude "not yet" — this
# script answers that without spawning one.
#
# Callable directly by a person running /aide-archive interactively, and
# by aide-run-spec as a pre-check before it decides whether to spawn the
# model at all. Idempotent: calling it twice for the same spec (once
# from each caller, in the same archive step) must never error or
# double-write — a folder already under archive/ is reported as
# already-archived rather than moved again, and a held-back section
# already matching the current verdict is left exactly as it is.
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, note?, specFolder?,
#    needsDocFeedback?}
#
# terminalReason, checked in this order:
#   refused | already-archived | conflict-open | not-implemented-yet
#   | no-passing-test-record | acceptance-criteria-unticked | archived
#
# Usage:
#   aide-archive-spec --project-dir <path> --spec <arg>
#                      [--specs-dir <path>] [--result-file <path>]
#
# --specs-dir names a directory in the specs repo, when that repo is
# separate from the project — checked for an open merge alongside
# --project-dir. The specs ROOT (where the spec folders actually live)
# is worked out the same way every other aide skill does: AIDE_SPECS_PATH
# from --project-dir's own .aide/config, or <project-dir>/specs.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"

project_dir=""; spec_arg=""; specs_dir=""; result_file=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --specs-dir) specs_dir="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

refuse() {
  local msg="$1" line
  line="$(jq -cn --arg e "$msg" '{ok:false, exitCode:2, terminalReason:"refused", error:$e}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 2
}

# One shape for every non-refusal outcome: ok:true, exitCode:0, plus
# whatever fields that outcome adds. $1 is a JSON object literal already
# carrying terminalReason and any extra fields.
emit_ok() {
  local extra="$1" line
  line="$(jq -cn --argjson extra "$extra" '{ok:true, exitCode:0} + $extra')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 0
}

[ -n "$project_dir" ] || refuse "missing --project-dir"
[ -n "$spec_arg" ] || refuse "missing --spec"
[ -d "$project_dir" ] || refuse "no such --project-dir: $project_dir"

# `--specs-dir`, when the caller names one, IS the specs root — not
# merely one more place the conflict check below also looks. A headless
# run passes its own per-run WORKTREE here (already rebased onto the
# latest base by `update_branch_to_base`), which is where `implement`'s
# real commits and a person's Overview ticks actually live. Falling
# through to `aide_specs_root`'s CONFIGURED path instead reads the
# shared, un-rebased checkout every other command reads for display —
# so every check below (`Workflow steps completed`, the Acceptance
# criteria gate) was silently answering from stale content, wrongly
# refusing with `not-implemented-yet` or `acceptance-criteria-unticked`
# for work that had genuinely happened (found 2026-08-31, on specs 287,
# 288, 290 and 291 — the same one-line bug behind all four). Untested
# until now because every existing fixture pointed `--specs-dir` and
# the configured `AIDE_SPECS_PATH` at the very same directory.
if [ -n "$specs_dir" ] && [ -d "$specs_dir" ]; then
  specs_root="$specs_dir"
elif declare -f aide_specs_root >/dev/null 2>&1; then
  specs_root="$(aide_specs_root "$project_dir")"
else
  specs_root="$project_dir/specs"
fi
[ -d "$specs_root" ] || refuse "no specs root at $specs_root"

spec_folder=""
if declare -f aide_resolve_spec >/dev/null 2>&1; then
  spec_folder="$(aide_resolve_spec "$spec_arg" "$specs_root")"
fi
# aide_resolve_spec's own "assume a full folder ID" branch (the one a
# spelled-out `NN-slug` falls into, as opposed to a bare number or a JIRA
# key) never checks archive/ — it only ever echoes the input back. A
# folder that exists only under archive/, given by its full name, comes
# out here as a guess that does not exist, so it is checked and — for
# exactly this case — looked up under archive/ directly, the same way
# aide-run-spec's own inline resolver already does for its recovery path.
if [ -n "$spec_folder" ] && [ ! -d "$specs_root/$spec_folder" ]; then
  spec_folder=""
fi
if [ -z "$spec_folder" ] && [ -d "$specs_root/archive" ]; then
  if [ -d "$specs_root/archive/$spec_arg" ]; then
    spec_folder="archive/$spec_arg"
  else
    for candidate in "$specs_root/archive"/*/; do
      base="$(basename "$candidate")"
      case "$base" in "$spec_arg"-*) spec_folder="archive/$base"; break ;; esac
    done
  fi
fi
if [ -z "$spec_folder" ]; then
  active="$(find "$specs_root" -maxdepth 1 -mindepth 1 -type d ! -name archive \
    -exec basename {} \; 2>/dev/null | sort | paste -sd', ' -)"
  refuse "unknown spec: $spec_arg (not under $specs_root)${active:+ — active folders: $active}"
fi

# --- already archived ---------------------------------------------------
# Covers a genuine re-run against finished work AND the dual-call-site
# case: aide-run-spec's own pre-check may have just done the stamp-and-
# move below, and the SKILL.md session's Step 1 then calls this script a
# second time for the same archive step. specFolder/needsDocFeedback are
# reported here too, same as the fresh `archived` outcome, so a caller
# that reaches this on that second call still knows where Step 4 reads
# from.
case "$spec_folder" in
  archive/*)
    folder_name="${spec_folder#archive/}"
    emit_ok "$(jq -cn --arg n "spec $folder_name is already archived — nothing to do" \
      --arg f "$spec_folder" \
      '{terminalReason:"already-archived", note:$n, specFolder:$f, needsDocFeedback:true}')"
    ;;
esac

# --- the conflict check ---------------------------------------------------
# aide-run-spec's own update_branch_to_base leaves MERGE_HEAD set for an
# archive step rather than aborting, so this can be running in a worktree
# that is mid-merge. Checked in every directory the caller named — the
# specs repo has a branch of its own and can conflict independently of
# the project (SKILL.md's own Step 1 already said so before this script
# existed).
check_dirs=("$project_dir")
[ -n "$specs_dir" ] && [ -d "$specs_dir" ] && check_dirs+=("$specs_dir")
for dir in "${check_dirs[@]}"; do
  if git -C "$dir" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    emit_ok '{"terminalReason":"conflict-open"}'
  fi
done

# --- the status-table read -------------------------------------------------
# Archiving no longer reads the Tasks tables at all (spec 268) — a
# checklist row is the implementer's own record of what happened, not a
# door a reader has to unlock by ticking boxes for work they did not do.
# The only question left is whether `implement` actually ran, read from
# the same `Workflow steps completed` line `aide-run-spec` writes.
status_file="$specs_root/$spec_folder/4-status.md"

implement_present="no"

if [ -f "$status_file" ]; then
  workflow_line="$(sed -n 's/^-[[:space:]]*\*\*Workflow steps completed:\*\*//p' "$status_file" | tail -1)"
  for step in $(printf '%s' "$workflow_line" | tr ',' ' '); do
    step="$(printf '%s' "$step" | tr -d '[:space:]`' | tr '[:upper:]' '[:lower:]')"
    [ "$step" = "implement" ] && implement_present="yes"
  done
fi

# --- removing the "## Archive held back" section ----------------------------
# The section is still removed on the way through — a stale one from
# before this change does not rot on an otherwise-finished spec — but
# nothing writes a new one again (spec 268 retires the tick-based
# held-back verdict entirely).
remove_held_back_section() {
  grep -q '^## Archive held back[[:space:]]*$' "$status_file" 2>/dev/null || return 0
  local tmp="$status_file.aide-tmp"
  awk '
    BEGIN { skip = 0 }
    /^## Archive held back[ \t]*$/ { skip = 1; next }
    skip && /^#{1,6}[ \t]/ { skip = 0 }
    skip && /^---[ \t]*$/ { skip = 0; next }
    skip { next }
    { print }
  ' "$status_file" > "$tmp" && mv "$tmp" "$status_file"
}

if [ "$implement_present" = "no" ]; then
  [ -f "$status_file" ] && remove_held_back_section
  emit_ok '{"terminalReason":"not-implemented-yet","note":"the spec has not reached implement yet — run /aide-implement next"}'
fi

# --- the test-record gate (spec 329) ----------------------------------------
# `$project_dir` is already past update_branch_to_base by the time this
# script runs (both call sites — aide-run-spec's pre-check and a
# person's own /aide-archive — pass it after that step), so HEAD here IS
# the commit about to be merged.
#
# The ONLY "earlier commit" this gate ever accepts is the automatic
# base-catch-up merge `update_branch_to_base` itself produces — verified
# by requiring HEAD to genuinely be a two-parent commit (`HEAD^2` must
# resolve) whose FIRST parent is the recorded one. A plain, single-parent
# commit added to the branch afterward (real, untested work) has no
# second parent, so `HEAD^2` fails to resolve and the record is refused.
record_file="$specs_root/$spec_folder/test-run.json"
head_commit="$(git -C "$project_dir" rev-parse HEAD 2>/dev/null || true)"
parent_commit="$(git -C "$project_dir" rev-parse HEAD^1 2>/dev/null || true)"
head_is_merge="no"
git -C "$project_dir" rev-parse --verify -q HEAD^2 >/dev/null 2>&1 && head_is_merge="yes"
record_ok="no"
if [ -f "$record_file" ]; then
  record_commit="$(jq -r '.commit // empty' "$record_file" 2>/dev/null)"
  record_exit="$(jq -r '.exitCode // empty' "$record_file" 2>/dev/null)"
  if [ "$record_exit" = "0" ] && [ -n "$record_commit" ]; then
    if [ "$record_commit" = "$head_commit" ]; then
      record_ok="yes"
    elif [ "$head_is_merge" = "yes" ] && [ "$record_commit" = "$parent_commit" ]; then
      record_ok="yes"
    fi
  fi
fi
if [ "$record_ok" = "no" ]; then
  # The gate MAKES the record it is missing rather than refusing for the
  # lack of one. It demanded a file only /aide-implement writes, and an
  # implement step locks once it is done — so a spec whose implement ran
  # before this gate existed could never satisfy it, however many times
  # archive was run. Three had to be merged and archived by hand the day
  # the gate shipped. A gate that can demand something nobody is able to
  # produce is a trap, not a gate; this one still refuses, but only when
  # the tests actually fail.
  test_cmd=""
  [ -f "$project_dir/.aide/config" ] \
    && test_cmd="$(sed -n 's/^AIDE_TEST_CMD=//p' "$project_dir/.aide/config" | tail -1)"
  if [ -z "$test_cmd" ]; then
    emit_ok '{"terminalReason":"no-passing-test-record","note":"no passing test run is on record, and this project has no test command configured — set the test command in .aide/config before archiving"}'
  fi
  "$SCRIPT_DIR/aide-record-test-run" --project-dir "$project_dir" \
    --specs-root "$specs_root" --folder "$spec_folder" --cmd "$test_cmd" >/dev/null 2>&1 || true
  if [ -f "$record_file" ]; then
    record_commit="$(jq -r '.commit // empty' "$record_file" 2>/dev/null)"
    record_exit="$(jq -r '.exitCode // empty' "$record_file" 2>/dev/null)"
    [ "$record_exit" = "0" ] && [ "$record_commit" = "$head_commit" ] && record_ok="yes"
  fi
fi
if [ "$record_ok" = "no" ]; then
  emit_ok '{"terminalReason":"no-passing-test-record","note":"the project'"'"'s tests did not pass for this commit — fix them before archiving"}'
fi

# --- the acceptance-criteria gate (spec 285) --------------------------------
# Scoped ONLY to the "## Acceptance criteria" section spec 268's own
# description deferred — never to the ordinary RED/GREEN/REFACTOR rows
# spec 268 already fixed above. No such section: progress_total is 0 and
# this check is a no-op, exactly REQ-4's "no Requirements section, no
# change in behavior." Reuses the same row-shape/done-mark rule
# aide-run-spec's Total progress line already uses (REQ-5), rather than a
# third, independent implementation of "is this row done".
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/status-progress.sh" ] && source "$SCRIPT_DIR/lib/status-progress.sh"

status_progress_for "$status_file" "Acceptance"
if [ "$progress_total" -gt 0 ] && [ "$progress_done" -lt "$progress_total" ]; then
  emit_ok '{"terminalReason":"acceptance-criteria-unticked","note":"tick every row under \"## Acceptance criteria\" in 4-status.md from the spec'"'"'s Checks tab before archiving — only a person can judge these"}'
fi

# --- archived: stamp and move ----------------------------------------------
[ -f "$status_file" ] && remove_held_back_section
today="$(date -u +%Y-%m-%d)"
printf '\n**Archived:** %s\n' "$today" >> "$status_file"

mkdir -p "$specs_root/archive"
if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$specs_root" mv "$spec_folder" "archive/$spec_folder"
else
  mv "$specs_root/$spec_folder" "$specs_root/archive/$spec_folder"
fi

emit_ok "$(jq -cn --arg f "archive/$spec_folder" \
  '{terminalReason:"archived", needsDocFeedback:true, specFolder:$f}')"
