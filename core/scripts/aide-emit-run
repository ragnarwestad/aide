#!/usr/bin/env bash
# aide-emit-run — report a TDD phase boundary from inside an
# /aide-implement run to the board.
#
#   aide-emit-run --phase red|green|verify [--spec N] [--command implement|archive]
#
# Called from a line in the aide-implement skill, never from a hook, so it
# never reads stdin (that would hang the very step it reports from) and takes
# the session id from $CLAUDE_SESSION_ID. POSTs {host, sessionId, command,
# phase, spec?, project?, capturedAt} to $AIDE_RUN_URL, which the board's
# runner sets for every step it spawns; without it nothing is sent. Only the
# command, spec reference and phase leave the machine.
#
# A call without --phase sends nothing, so a hook still pointing here is
# harmless.
#
# Discipline:
#   * stdout is silent
#   * always exit 0
#   * never block: curl is backgrounded with a 1 s cap
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { cat <<'USAGE'
Usage:
  aide-emit-run --phase red|green|verify [--spec N] [--command implement|archive]
USAGE
exit 0; }
exec >/dev/null 2>&1
trap 'exit 0' EXIT

[ -n "${AIDE_RUN_URL:-}" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
command -v curl >/dev/null 2>&1 || exit 0

post() {
  curl -s --max-time 1 -X POST -H 'content-type: application/json' \
    --data "$1" "$AIDE_RUN_URL" >/dev/null 2>&1 &
}

# The project is the checkout's name, never its path.
project_of() {
  local dir="$1" top
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  basename "${top:-$dir}"
}

host="$(hostname -s 2>/dev/null || hostname)"
captured_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- phase mode --------------------------------------------------------------
# Every flag reads the next argument but shifts one: a value that then
# gets scanned as a flag simply matches nothing, and no shift can ever
# run past the end.
phase=""; spec=""; cmd="implement"
while [ $# -gt 0 ]; do
  case "$1" in
    --phase) phase="${2:-}" ;;
    --spec) spec="${2:-}" ;;
    --command) cmd="${2:-}" ;;
  esac
  shift
done

if [ -n "$phase" ]; then
  # Only the three TDD phases. Anything else is a typo, and a typo must
  # not reach the dashboard.
  case "$phase" in red|green|verify) ;; *) exit 0 ;; esac

  # The session id is what joins this event to the run on /live.
  session_id="${CLAUDE_SESSION_ID:-}"
  [[ "$session_id" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || exit 0
  [[ "$spec" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || spec=""

  payload="$(jq -cn \
    --arg host "$host" --arg sid "$session_id" --arg cmd "$cmd" \
    --arg spec "$spec" --arg project "$(project_of "$PWD")" \
    --arg phase "$phase" --arg at "$captured_at" \
    '{host: $host, sessionId: $sid, command: $cmd, phase: $phase, capturedAt: $at}
     + (if $spec != "" then {spec: $spec} else {} end)
     + (if $project != "" then {project: $project} else {} end)')"
  post "$payload"
  exit 0
fi

exit 0
