#!/usr/bin/env bash
# aide-emit-run — link a Claude Code session to the aide spec it works
# on (spec 80), and report TDD phase boundaries from inside a run
# (spec 81, slice 81c).
#
# Two modes, one payload:
#
#   * hook mode (no arguments): reads the UserPromptSubmit JSON from
#     stdin. If the prompt is a slash-launched aide command
#     (`/aide-<command> [<spec>]`, tolerating the leading space real
#     prompts carry), POSTs {host, sessionId, command, spec?, project?,
#     capturedAt}.
#   * phase mode (`--phase red|green|refactor [--spec N]`): called from
#     a line in the aide-implement skill, NOT from a hook — so it never
#     reads stdin (that would hang the very step it reports from) and
#     takes the session id from $CLAUDE_SESSION_ID. Same payload plus
#     `phase`.
#
# Only the parsed command, spec reference and phase leave the machine —
# never the prompt body. Both modes need AIDE_RUN_URL; without it
# nothing is sent.
#
# Prompt-hook discipline (non-negotiable):
#   * stdout is injected into the model's context -> silence it, line one
#   * a non-zero exit blocks the prompt -> always exit 0
#   * never block: curl is backgrounded with a 1 s cap
exec >/dev/null 2>&1
trap 'exit 0' EXIT

[ -n "${AIDE_RUN_URL:-}" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
command -v curl >/dev/null 2>&1 || exit 0

post() {
  curl -s --max-time 1 -X POST -H 'content-type: application/json' \
    --data "$1" "$AIDE_RUN_URL" >/dev/null 2>&1 &
}

# The project is the checkout's name, never its path.
project_of() {
  local dir="$1" top
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  basename "${top:-$dir}"
}

host="$(hostname -s 2>/dev/null || hostname)"
captured_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- phase mode --------------------------------------------------------------
# Every flag reads the next argument but shifts one: a value that then
# gets scanned as a flag simply matches nothing, and no shift can ever
# run past the end.
phase=""; spec=""; cmd="implement"
while [ $# -gt 0 ]; do
  case "$1" in
    --phase) phase="${2:-}" ;;
    --spec) spec="${2:-}" ;;
    --command) cmd="${2:-}" ;;
  esac
  shift
done

if [ -n "$phase" ]; then
  # Only the three TDD phases. Anything else is a typo, and a typo must
  # not reach the dashboard.
  case "$phase" in red|green|refactor) ;; *) exit 0 ;; esac

  # The session id is what joins this event to the run on /live. In
  # print mode there is no hook JSON to read it from.
  session_id="${CLAUDE_SESSION_ID:-}"
  [[ "$session_id" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || exit 0
  [[ "$spec" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || spec=""

  payload="$(jq -cn \
    --arg host "$host" --arg sid "$session_id" --arg cmd "$cmd" \
    --arg spec "$spec" --arg project "$(project_of "$PWD")" \
    --arg phase "$phase" --arg at "$captured_at" \
    '{host: $host, sessionId: $sid, command: $cmd, phase: $phase, capturedAt: $at}
     + (if $spec != "" then {spec: $spec} else {} end)
     + (if $project != "" then {project: $project} else {} end)')"
  post "$payload"
  exit 0
fi

# --- hook mode ---------------------------------------------------------------
input="$(cat)"
prompt="$(printf '%s' "$input" | jq -r '.prompt // empty')"
[ -n "$prompt" ] || exit 0

# Anchored: optional leading whitespace, then /aide-<command>, then an
# optional argument. NEVER an unanchored search — prose that merely
# mentions a command must not match.
re='^[[:space:]]*/aide-(explore|create|analyze|review-plan|implement|archive|manifest|make-tests|to-pdf|to-html|react-class-to-func)([[:space:]]+([^[:space:]]+))?'
[[ "$prompt" =~ $re ]] || exit 0
cmd="${BASH_REMATCH[1]}"
spec="${BASH_REMATCH[3]:-}"

session_id="$(printf '%s' "$input" | jq -r '.session_id // empty')"
[[ "$session_id" =~ ^[A-Za-z0-9._-]{1,128}$ ]] || exit 0

project="$(project_of "$(printf '%s' "$input" | jq -r '.cwd // empty')")"

payload="$(jq -cn \
  --arg host "$host" --arg sid "$session_id" --arg cmd "$cmd" \
  --arg spec "$spec" --arg project "$project" --arg at "$captured_at" \
  '{host: $host, sessionId: $sid, command: $cmd, capturedAt: $at}
   + (if $spec != "" then {spec: $spec} else {} end)
   + (if $project != "" then {project: $project} else {} end)')"

post "$payload"
exit 0
