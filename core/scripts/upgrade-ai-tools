#!/bin/bash
# Upgrades all AI tools installed via mise
# Can be run manually or via cron (see .claude/rules/development.md)

export PATH="$HOME/.local/bin:$PATH"

echo "Upgrading AI tools via mise..."
mise upgrade npm:@github/copilot npm:@openai/codex opencode ollama npm:markdownlint-cli2 jq gh bun pandoc npm:md-to-pdf

echo ""
echo "Upgrading Claude Code (not managed by mise)..."
claude update

echo ""
echo "Installed versions:"
mise ls | grep -E "copilot|codex|opencode|ollama|markdownlint|jq|gh|bun|pandoc|md-to-pdf"
claude --version
