#!/usr/bin/env bash
# aide-run-spec — run ONE aide workflow step for ONE spec headless, with
# guards and caps (spec 81 in aide-specs).
#
# The guards are the product. An unguarded `claude -p` is one line and
# needs no script; what needs writing down is everything this refuses to
# do, and what it leaves behind when a run is cut short.
#
# Prints ONE JSON line to stdout and to --result-file:
#   {ok, exitCode, sessionId, costUsd, costMeasured, terminalReason,
#    subtype, durationSec, repos[{root, headBefore, headAfter,
#    changedFiles}], error}
#
# terminalReason is this script's own vocabulary, not the CLI's:
#   completed | budget | timeout | refused | spawn-failed | cli-error
#
# Exit: 0 when a run happened and was reported (stopped runs included),
#       2 when the run was refused before anything started.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"

WORKFLOW_STEPS="explore create analyze review-plan implement archive manifest"

project_dir=""; command_name=""; spec_arg=""; budget_usd=""; timeout_sec=""
permission_mode=""; result_file=""; model=""; session_id=""
kill_grace_sec="30"; do_pull="no"; dry_run="no"

while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --command) command_name="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --budget-usd) budget_usd="${2:-}"; shift 2 ;;
    --timeout-sec) timeout_sec="${2:-}"; shift 2 ;;
    --permission-mode) permission_mode="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --session-id) session_id="${2:-}"; shift 2 ;;
    --kill-grace-sec) kill_grace_sec="${2:-}"; shift 2 ;;
    --pull) do_pull="yes"; shift ;;
    --dry-run) dry_run="yes"; shift ;;
    *) printf '{"ok":false,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

# --- refusal ----------------------------------------------------------------
# One place, one shape: a refusal is still a JSON line, so a caller never
# has to parse two formats.
refuse() {
  local msg="$1"
  local line
  line="$(jq -cn --arg e "$msg" \
    '{ok:false, exitCode:2, terminalReason:"refused", costUsd:0, costMeasured:false, error:$e}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 2
}

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"error":"jq is required"}'; exit 2; }

is_positive_number() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]] && (( $(echo "$1 > 0" | bc -l) )); }

[ -n "$project_dir" ] || refuse "missing --project-dir"
[ -n "$command_name" ] || refuse "missing --command"
[ -n "$spec_arg" ] || refuse "missing --spec"
[ -n "$budget_usd" ] || refuse "missing --budget-usd"
[ -n "$timeout_sec" ] || refuse "missing --timeout-sec"
# Never defaulted: the most dangerous knob in the stage is typed out by
# whoever starts the run, or the run does not start.
[ -n "$permission_mode" ] || refuse "missing --permission-mode"
[ -n "$result_file" ] || refuse "missing --result-file"

is_positive_number "$budget_usd" || refuse "invalid --budget-usd: $budget_usd"
is_positive_number "$timeout_sec" || refuse "invalid --timeout-sec: $timeout_sec"

case " $WORKFLOW_STEPS " in
  *" $command_name "*) ;;
  *) refuse "invalid --command: $command_name (not an aide workflow step)" ;;
esac

[ -d "$project_dir" ] || refuse "no such --project-dir: $project_dir"
project_root="$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null)" \
  || refuse "not a git repository: $project_dir"

# The specs root is usually a DIFFERENT repository (AIDE_SPECS_PATH): it
# is where analyze and review-plan actually write, so every check below
# covers both roots, not just the project.
if declare -f aide_specs_root >/dev/null 2>&1; then
  specs_root="$(aide_specs_root "$project_root")"
else
  specs_root="$project_root/specs"
fi
[ -d "$specs_root" ] || refuse "no specs root at $specs_root"

spec_folder=""
if [ -d "$specs_root/$spec_arg" ]; then
  spec_folder="$spec_arg"
else
  for candidate in "$specs_root"/*/; do
    base="$(basename "$candidate")"
    case "$base" in "$spec_arg"-*) spec_folder="$base"; break ;; esac
  done
fi
[ -n "$spec_folder" ] || refuse "unknown spec: $spec_arg (not under $specs_root)"
spec_id="${spec_folder%%-*}"

specs_repo="$(git -C "$specs_root" rev-parse --show-toplevel 2>/dev/null || true)"

roots=("$project_root")
[ -n "$specs_repo" ] && [ "$specs_repo" != "$project_root" ] && roots+=("$specs_repo")

for root in "${roots[@]}"; do
  if [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then
    label="project"
    [ "$root" != "$project_root" ] && label="specs"
    refuse "the $label tree is dirty: $root"
  fi
done

if [ "$do_pull" = "yes" ]; then
  for root in "${roots[@]}"; do
    if git -C "$root" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      git -C "$root" pull -q --ff-only 2>/dev/null || refuse "cannot fast-forward $root"
    fi
  done
fi

# --- the invocation ----------------------------------------------------------
claude_bin="${AIDE_CLAUDE_BIN:-}"
if [ -z "$claude_bin" ]; then
  if [ -x "$HOME/.local/bin/claude" ]; then
    claude_bin="$HOME/.local/bin/claude"
  else
    claude_bin="$(command -v claude 2>/dev/null || true)"
  fi
fi
[ -n "$claude_bin" ] && [ -x "$claude_bin" ] || refuse "cannot find the claude binary (set AIDE_CLAUDE_BIN)"

prompt="/aide-$command_name $spec_id"
argv=("$claude_bin" -p --output-format json
      --max-budget-usd "$budget_usd" --permission-mode "$permission_mode")
[ -n "$model" ] && argv+=(--model "$model")
[ -n "$session_id" ] && argv+=(--session-id "$session_id")

if [ "$dry_run" = "yes" ]; then
  # Build the argv array separately: jq's --args still parses a leading
  # dash as an option, and every entry here starts with one.
  argv_json="$(printf '%s\n' "${argv[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  line="$(jq -cn --arg p "$prompt" --arg cwd "$project_root" --arg specs "$specs_root" \
    --argjson argv "$argv_json" \
    '{ok:true, dryRun:true, prompt:$p, projectRoot:$cwd, specsRoot:$specs, argv:$argv}')"
  printf '%s\n' "$line"
  printf '%s\n' "$line" > "$result_file"
  exit 0
fi

branch="aide/$spec_folder"
git -C "$project_root" switch -q "$branch" 2>/dev/null \
  || git -C "$project_root" switch -q -c "$branch" 2>/dev/null \
  || refuse "cannot switch to $branch in $project_root"

# Parallel indexed arrays, not an associative one: macOS ships bash 3.2,
# where `declare -A` does not exist.
head_before=()
for root in "${roots[@]}"; do
  head_before+=("$(git -C "$root" rev-parse HEAD 2>/dev/null || echo "")")
done

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT
printf '%s' "$prompt" > "$work_dir/prompt"

started_at="$(date +%s)"

# `set -m` puts the child in its OWN process group, so the deadline can
# take down claude's children too — a kill that only reaches the parent
# is not a bound. No pipeline here: with one, $! is the last command and
# the group id would be someone else's.
set -m
# cd into the project FIRST. A skill resolves the project from its
# working directory, so inheriting the caller's cwd (a server's, say)
# makes the run analyse the wrong repository — measured on the first
# real job, 2026-08-16, which cost $0.45 to discover. `exec` keeps the
# pid, so $! is still the process group we later signal.
( cd "$project_root" && exec "${argv[@]}" ) < "$work_dir/prompt" > "$work_dir/out" 2> "$work_dir/err" &
child=$!
set +m

kill_group() {
  kill "-$1" "-$child" 2>/dev/null || kill "-$1" "$child" 2>/dev/null || true
}

stopped=""
deadline=$(( started_at + ${timeout_sec%.*} ))
while kill -0 "$child" 2>/dev/null; do
  if [ "$(date +%s)" -ge "$deadline" ]; then
    stopped="timeout"
    # SIGTERM first, always: a run being asked to stop is exactly when a
    # few extra seconds are cheapest.
    kill_group TERM
    grace_end=$(( $(date +%s) + ${kill_grace_sec%.*} ))
    while kill -0 "$child" 2>/dev/null && [ "$(date +%s)" -lt "$grace_end" ]; do sleep 0.2; done
    kill -0 "$child" 2>/dev/null && kill_group KILL
    break
  fi
  sleep 0.2
done
wait "$child" 2>/dev/null
exit_code=$?
duration=$(( $(date +%s) - started_at ))

# --- reading what came back --------------------------------------------------
session_out=""; subtype=""; cost="0"; cost_measured="false"; terminal_reason=""; error_msg=""

if jq -e . "$work_dir/out" >/dev/null 2>&1; then
  session_out="$(jq -r '.session_id // empty' "$work_dir/out")"
  subtype="$(jq -r '.subtype // empty' "$work_dir/out")"
  cost="$(jq -r '.total_cost_usd // 0' "$work_dir/out")"
  cost_measured="true"
fi

if [ -n "$stopped" ]; then
  terminal_reason="timeout"
  # A SIGKILLed run prints nothing, so the cost cannot be measured. The
  # accounting must over-charge what it could not measure, never under.
  cost="$budget_usd"; cost_measured="false"
  error_msg="killed after ${timeout_sec}s"
elif [ "$cost_measured" = "true" ]; then
  case "$subtype" in
    success) terminal_reason="completed" ;;
    error_max_budget_usd) terminal_reason="budget"; error_msg="the step's budget was reached" ;;
    *) terminal_reason="cli-error"; error_msg="$(jq -r '(.errors // []) | join("; ")' "$work_dir/out")" ;;
  esac
else
  terminal_reason="cli-error"
  cost="$budget_usd"; cost_measured="false"
  error_msg="$(tail -c 400 "$work_dir/err" 2>/dev/null | tr '\n' ' ')"
  [ -n "$error_msg" ] || error_msg="claude produced no result JSON (exit $exit_code)"
fi

ok="false"
[ "$terminal_reason" = "completed" ] && ok="true"

# --- leaving the machine usable ----------------------------------------------
# Whatever the step managed to write is committed, with the reason in the
# message. Leaving it uncommitted is not the safe option it looks like:
# the dirty-tree refusal above would block every later run.
suffix=""
[ "$terminal_reason" != "completed" ] && suffix=" (stopped: $terminal_reason)"

repos_json="[]"
i=0
for root in "${roots[@]}"; do
  changed="$(git -C "$root" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$changed" -gt 0 ]; then
    git -C "$root" add -A >/dev/null 2>&1
    git -C "$root" commit -q -m "Run /aide-$command_name for $spec_folder (headless)$suffix" >/dev/null 2>&1 || true
  fi
  repos_json="$(jq -c --arg root "$root" --arg before "${head_before[$i]}" \
    --arg after "$(git -C "$root" rev-parse HEAD 2>/dev/null || echo "")" \
    --argjson changed "$changed" \
    '. + [{root:$root, headBefore:$before, headAfter:$after, changedFiles:$changed}]' <<<"$repos_json")"
  i=$(( i + 1 ))
done

line="$(jq -cn \
  --argjson ok "$ok" --argjson exitCode "$exit_code" \
  --arg sessionId "${session_out:-$session_id}" \
  --argjson costUsd "$cost" --argjson costMeasured "$cost_measured" \
  --arg terminalReason "$terminal_reason" --arg subtype "$subtype" \
  --argjson durationSec "$duration" --argjson repos "$repos_json" \
  --arg error "$error_msg" --arg branch "$branch" \
  '{ok:$ok, exitCode:$exitCode, sessionId:$sessionId, costUsd:$costUsd,
    costMeasured:$costMeasured, terminalReason:$terminalReason,
    subtype:$subtype, durationSec:$durationSec, branch:$branch,
    repos:$repos, error:(if $error == "" then null else $error end)}')"

# The result file is written LAST and by rename, so a reader never sees a
# half-written one — and it is written on every path, including a stop:
# a detached child has no pipe home, so this file is the contract.
printf '%s\n' "$line" > "$result_file.tmp" && mv "$result_file.tmp" "$result_file"
printf '%s\n' "$line"
exit 0
