#!/usr/bin/env bash
# aide-run-spec — run ONE aide workflow step for ONE spec headless, with
# guards and caps (spec 81 in aide-specs).
#
# The guards are the product. An unguarded `claude -p` is one line and
# needs no script; what needs writing down is everything this refuses to
# do, and what it leaves behind when a run is cut short.
#
# Prints ONE JSON line to stdout and to --result-file:
#   {ok, exitCode, sessionId, costUsd, costMeasured, terminalReason,
#    subtype, durationSec, repos[{root, headBefore, headAfter,
#    changedFiles}], error}
#
# A `create` step adds one field: `specFolder`, the spec the run turned
# out to make (spec 93). Present only when exactly one new folder
# appeared under the specs root — absent means the run would have had to
# guess which, and it did not.
#
# A refusal adds `errorReason` when the reason is one a machine acts on
# (spec 153): `"conflict"` says the branch would not merge with the
# default branch, and the dashboard row shows that as the failure's own
# text. Since spec 171 it is not a control: `archive` resolves the
# conflict itself, so a conflict that reaches a reader is one no machine
# could settle. Same rule as `specFolder` — the key is ABSENT, never null
# or empty, for every refusal with nothing to say.
#
# An `archive` step adds `note` when the spec it was pointed at turned
# out to be finished already (spec 211): the folder is under `archive/`
# and its branch is gone from every root's origin, so there is nothing to
# archive. Success with nothing to do, not a refusal — same rule as
# `specFolder`, the key is ABSENT for every other outcome.
#
# A measured run adds `tokens` (spec 118): {input, output, cacheRead,
# cacheCreation, total}, read off claude's own usage block. Same rule as
# `specFolder` — absent, never zeroed, when there was nothing to
# measure. Unlike the cost, it is never assumed: a killed run is charged
# its full budget and reports no token count at all.
#
# terminalReason is this script's own vocabulary, not the CLI's:
#   completed | budget | timeout | provider-limit | refused | spawn-failed | cli-error
#   | already-landed
#
# --stream-file PATH keeps the claude transcript (stream-json, one event
# per line) at PATH instead of discarding it with the working directory.
# Opt-in: without it, nothing about this script's behaviour changes.
#
# Every run works in a `git worktree` of its own, one per repo it touches
# (spec 91). The real checkouts are only ever put back ON their default
# branch and read; nothing switches them to a spec branch. That is what
# lets two runs go at once against the same repositories — and it is also
# why the dashboard's spec list stops describing whatever branch a
# running job happens to be on.
#
# Exit: 0 when a run happened and was reported (stopped runs included),
#       0 when there was nothing to do and the script says so,
#       2 when the run was refused before anything started.
#
# Sets AIDE_HEADLESS=1 in the child's environment. This script is the
# only caller that runs a workflow step with nobody there to answer, and
# a skill cannot tell that from inside: three archive jobs stopped on a
# confirmation question, reported `done` and moved nothing. A skill that
# has a question only a person can answer branches on this and writes
# the question down instead of asking it.

set -uo pipefail

# Run from a private copy of ourselves. Bash reads a script
# incrementally from disk by byte offset, so replacing the file
# mid-execution kills the run — and an aide `implement` step reinstalls
# aide, which copies this very script over itself. Measured 2026-08-16:
# that took the runner down eight minutes into a job whose work had
# already succeeded, leaving no result file. The copy unlinks itself
# immediately; the open file handle keeps it alive for as long as we
# run.
#
# The marker holds the copy's OWN path, and both markers are unset
# before anything else runs. An earlier version marked "I am a copy"
# with a bare flag and left it exported: `claude` inherited it, so every
# nested invocation — a test, a terminal inside the run, the next step —
# believed the INSTALLED script was the throwaway copy and deleted it.
# Measured 2026-08-16, one test run removed core/scripts/aide-run-spec
# from the worktree.
if [ "${AIDE_RUN_SPEC_SELF_COPY:-}" != "$0" ]; then
  _self_copy="$(mktemp -t aide-run-spec)" || exit 2
  cp "${BASH_SOURCE[0]}" "$_self_copy" && chmod +x "$_self_copy" || exit 2
  AIDE_RUN_SPEC_SELF_COPY="$_self_copy" \
  AIDE_RUN_SPEC_SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" \
    exec "$_self_copy" "$@"
fi
# In the copy: keep the directory the original came from (the shared
# library lives beside it), then drop the file — it is ours, and only
# ours, because the marker matched our own path.
SCRIPT_DIR="${AIDE_RUN_SPEC_SOURCE_DIR:-$(cd "$(dirname "$0")" && pwd)}"
unset AIDE_RUN_SPEC_SELF_COPY AIDE_RUN_SPEC_SOURCE_DIR
rm -f "$0"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/status-progress.sh" ] && source "$SCRIPT_DIR/lib/status-progress.sh"
# spec 355: the spec's state file, derived from the prose this script
# rewrites below. Guarded like status-progress.sh above.
[ -f "$SCRIPT_DIR/lib/spec-state.sh" ] && source "$SCRIPT_DIR/lib/spec-state.sh"
# spec 356: the one table and function pair that decide and record a
# spec's phase moves — pure phase order only. The dependency gate below
# (DEPENDENCY_GATED_STEPS) stays a standalone check, same as archive's
# acceptance-criteria/test-record gates in aide-archive-spec: it runs for
# BOTH implement and archive before either script's own phase-order
# check, and archive's phase-order check lives in a different process
# (aide-archive-spec) that never shares this gate's resolver functions.
[ -f "$SCRIPT_DIR/lib/spec-transitions.sh" ] && source "$SCRIPT_DIR/lib/spec-transitions.sh"

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

# Each phase of this run is a file beside the script (split 2026-09-04).
# A missing one is an installation that did not finish, and it says so:
# `source` on its own would die under `set -e` with no JSON at all, and
# a caller reading the result file would see nothing but an exit code.
need_part() {
  [ -f "$SCRIPT_DIR/lib/$1" ] && return 0
  echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"lib/'"$1"' is missing beside aide-run-spec — reinstall aide (implementations/claude-code/install.sh)"}'
  exit 2
}

# EVERY phase, before the first one runs. Checked one at a time where
# each is sourced, a missing late phase was only found after the step had
# run and the money was spent.
for _part in run-spec-arguments.sh run-spec-code-landing.sh run-spec-gates.sh run-spec-invocation.sh run-spec-checkouts.sh run-spec-worktree.sh run-spec-branch.sh run-spec-spec-paths.sh run-spec-cleanup.sh run-spec-records.sh run-spec-status-line.sh run-spec-specs-guard.sh run-spec-boundary.sh run-spec-outcome.sh run-spec-publish.sh; do need_part "$_part"; done
# --- the vocabulary, the command line, and what they refuse ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-arguments.sh"

# --- how this project lands its code ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-code-landing.sh"

# --- the refusals that come before any AI is spent ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-gates.sh"

# --- finding the tool and building its command line ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-invocation.sh"

# --- the throwaway checkout each run works in ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-checkouts.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-worktree.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-branch.sh"

# --- where the spec folder is, what a step may write, and reading what came back ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-spec-paths.sh"

# --- leaving the machine usable ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-cleanup.sh"

# --- the record of what has run ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-records.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-status-line.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-specs-guard.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-boundary.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-outcome.sh"

# --- committing and publishing, confirmed against origin ---
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/run-spec-publish.sh"

# --- what a `close` step actually DID, in the script's own word -------------
# The dashboard lands a close on `closed` alone (runner-setup.ts), and a
# session's own terminal reason is `completed` whatever it did — so
# without this the merge was skipped in silence: the folder was stamped
# and moved on the branch, and main never saw it.
#
# `aide-close-spec` is the one thing that knows. It is idempotent —
# `already-closed` is its answer to a second call — so asking it again
# after the session either confirms what the skill just did, does the
# stamp-and-move itself if the skill did not, or says `conflict-open`
# for a merge still open. Run BEFORE PASS 1, so anything it moves is
# committed and pushed with the rest of the step's work.
#
# Only after a session that finished: a run that failed, timed out or
# was refused must not have its spec closed as a side effect of asking.
#
# The answer is only REMEMBERED here. `terminal_reason` stays
# `completed` through the pushing below, so an unpushed close still
# takes the `unpushed` branch every other step takes — a `closed` the
# dashboard would land while the branch never reached origin is the one
# thing this must not report.
close_outcome=""
if [ "$command_name" = "close" ] && [ "$terminal_reason" = "completed" ]; then
  close_args=(--project-dir "$project_wt" --spec "$spec_folder" --reason "$reason")
  [ "$specs_root_wt" != "$project_wt" ] && close_args+=(--specs-dir "$specs_root_wt")
  close_after="$("$SCRIPT_DIR/aide-close-spec" "${close_args[@]}" 2>/dev/null)"
  close_outcome="$(jq -r '.terminalReason // empty' <<<"$close_after" 2>/dev/null)"
fi

# --- PASS 1: the step's own content, unconditionally, every command ---------
commit_and_push_roots

# --- REQ-1/REQ-2/REQ-3: only a step that would land on the line at all ------
# is asked whether origin confirmed it — no-progress/scope-violation/
# cli-error/timeout/budget/provider-limit runs were never going to be added
# to the line regardless of push outcome (completed_steps_for's own guard,
# below, already excludes them), so they are not asked this question
# either. This IS the last git operation performed against a root that
# fails it: the `elif` below, where anything else touches git again, only
# runs when this check has NOT just failed.
if [ "$terminal_reason" = "completed" ] && [ -n "$status_file" ] \
   && ! roots_confirmed_on_origin; then
  # The line is never touched — nothing was written to it yet, so it
  # reads exactly as it did before this run, both locally and on origin
  # (REQ-3). A re-run is a normal ok:false result, not a refusal (REQ-4):
  # the step is retried like any other failed step, and
  # commit_and_push_roots's own widened gate retries whatever this run
  # left stuck, whether or not the re-run's own session changes anything.
  ok="false"
  terminal_reason="unpushed"
  suffix=" (stopped: unpushed)"
  error_msg="the step's own work did not reach origin: $unpushed_roots"
elif [ -n "$status_file" ]; then
  completed_steps_for "$commit_label" "$(dirname "$status_file")" "$status_file" "$specs_ref_before"
  # Nothing derived leaves the file alone: an empty line says less than
  # the one already there.
  #
  # spec 356: write_phase_stamp (core/scripts/lib/spec-transitions.sh) is
  # the one place this line is formatted and written — historical
  # `- **Model (<step>):**` lines an old archive still carries (spec 217,
  # superseded by spec 245's per-file record below) are left exactly
  # where they sit, same as before: the function touches only the line
  # it owns.
  if declare -f write_phase_stamp >/dev/null 2>&1; then
    write_phase_stamp "$status_file" "workflow-line" "$completed_steps"
  fi

  # Nothing derived leaves the file alone: a fresh spec whose Phase
  # tables have no rows yet keeps whatever placeholder it started with.
  status_progress_for "$status_file"
  if [ "$progress_total" -gt 0 ]; then
    progress_pct=$(( (progress_done * 100 + progress_total / 2) / progress_total ))
    # Format-agnostic on purpose (real specs disagree on bold/position
    # for this line, spec 246) — only the digits are touched, everything
    # else on the line survives.
    awk -v pct="$progress_pct" -v done="$progress_done" -v total="$progress_total" '
      BEGIN { written = 0 }
      !written && /Total progress/ {
        line = $0
        sub(/[0-9]+%/, pct "%", line)
        sub(/\([0-9]+[ \t]+(of|av)[ \t]+[0-9]+/, "(" done " of " total, line)
        print line; written = 1; next
      }
      { print }
    ' "$status_file" > "$work_dir/status-progress" 2>/dev/null
    if [ -s "$work_dir/status-progress" ] && \
       ! cmp -s "$work_dir/status-progress" "$status_file"; then
      cat "$work_dir/status-progress" > "$status_file" 2>/dev/null || true
    fi
  fi

  # --- the spec's state file (spec 355) --------------------------------
  # 4-status.md is the prose; 4-status.json is what the gates and the
  # dashboard read. Derived here from the prose just rewritten, by the
  # same library aide-write-spec and aide-archive-spec use — so a run
  # that lands `analyze` on the line also lands it in the file the
  # implement gate reads. Spec 355 changed the tests to expect this and
  # never gave the runner the code: every analyze after it left the file
  # stale, and the dashboard held the next implement back as "not
  # analyzed yet". Only for a step that completed: a stopped run changes
  # no phase, and a first-ever state file on its branch would keep an
  # otherwise empty branch alive that the sweep below is meant to
  # delete. The state file keeps its own list of completed phases rather
  # than re-deriving it from prose (spec 355), so the list this run just
  # wrote to the prose line is handed over — a file that already existed
  # before the run would otherwise go on naming only the phases it had.
  # Placed here, after completed_steps_for has actually run (spec 343
  # moved that call into this same branch), rather than at this block's
  # original, earlier position — $completed_steps does not exist yet at
  # that point any more, and this write has to ride PASS 2's commit
  # anyway, same as the prose line it derives from.
  if [ "$terminal_reason" = "completed" ] && [ -f "$status_file" ] && declare -f write_spec_state >/dev/null 2>&1; then
    write_spec_state "$status_file" "$completed_steps" >/dev/null 2>&1 || true
  fi

  # --- PASS 2: the line has to clear the same bar (REQ-2) -------------
  commit_and_push_roots
  if [ "$terminal_reason" = "completed" ] && ! roots_confirmed_on_origin; then
    ok="false"
    terminal_reason="unpushed"
    suffix=" (stopped: unpushed)"
    error_msg="the workflow-steps line did not reach origin: $unpushed_roots"
  fi
fi

# The close's own word, now that the push has been confirmed: a spec
# that was stamped and moved, and whose branch reached origin, is
# `closed` — the one terminal reason the dashboard lands a close on.
# Anything else the script answered (`conflict-open`, `refused`,
# `already-archived`) moved nothing, so `completed` stands and nothing
# is landed.
if [ "$terminal_reason" = "completed" ]; then
  case "$close_outcome" in
    closed|already-closed) terminal_reason="closed" ;;
  esac
fi

# --- $repos_json, built ONCE, from the run's true start and final end -------
# Not built inside commit_and_push_roots any more: a second call's own
# "nothing changed here" must never overwrite a first call's real
# headBefore/changedFiles for the same root, which building it fresh
# inside the loop, every call, would do.
i=0
for root in "${roots[@]}"; do
  repos_json="$(jq -c --arg root "$root" --arg worktree "${work_roots[$i]}" \
    --arg before "${head_before[$i]}" --arg after "${head_after_per_root[$i]}" \
    --argjson changed "${changed_files_per_root[$i]}" \
    '. + [{root:$root, worktree:$worktree, headBefore:$before, headAfter:$after, changedFiles:$changed}]' <<<"$repos_json")"
  i=$(( i + 1 ))
done

# A pull request is the same work, one level more public. `gh` on an
# unattended machine needs an interactive re-auth only a human can do,
# so a broken gh records its error and leaves the run successful.
if [ "$push_mode" = "pr" ]; then
  gh_bin="${AIDE_GH_BIN:-$(command -v gh 2>/dev/null || true)}"
  if [ -z "$gh_bin" ] || [ ! -x "$gh_bin" ]; then
    pr_error="cannot find the gh binary (set AIDE_GH_BIN, or run gh auth login)"
  elif [ -n "$push_error" ]; then
    pr_error="no pull request: the branch was not pushed"
  else
    if pr_out="$(cd "$project_wt" && "$gh_bin" pr create \
        --base "$(default_branch "$project_root")" --head "$branch" \
        --title "Run /aide-$command_name for $commit_label" \
        --body "Headless aide run ($command_name, $commit_label)$suffix." 2>&1)"; then
      pr_url="$(printf '%s\n' "$pr_out" | grep -o 'https://[^[:space:]]*' | tail -1)"
      [ -n "$pr_url" ] || pr_error="gh reported no pull request URL"
    else
      pr_error="$(printf '%s' "$pr_out" | tr '\n' ' ' | tail -c 200)"
    fi
  fi
fi

# ABSENT, not zero, when there is no dollar figure at all (spec 125).
# `tokens` has followed this rule since spec 118; `costUsd` did not,
# because every claude path DOES produce a number — including the
# deliberate over-charge a killed run is billed. Codex has nothing to
# over-charge FROM, and a 0 in this field would be summed into the
# job's spend as if the step had been free.
cost_json="null"
[ "$cost_known" = "true" ] && cost_json="$cost"

line="$(jq -cn \
  --argjson ok "$ok" --argjson exitCode "$exit_code" \
  --arg sessionId "${session_out:-$session_id}" \
  --arg tool "$tool" \
  --argjson costUsd "$cost_json" --argjson costMeasured "$cost_measured" \
  --arg terminalReason "$terminal_reason" --arg subtype "$subtype" \
  --argjson durationSec "$duration" --argjson repos "$repos_json" \
  --arg error "$error_msg" --arg branch "$branch" --arg push "$push_mode" \
  --arg branchUrl "$branch_url" --argjson branchUrls "$branch_urls_json" \
  --arg prUrl "$pr_url" \
  --arg prError "$pr_error" --arg pushError "$push_error" \
  --arg pullError "$pull_error" --arg specFolder "$created_spec_folder" \
  --arg worktreeLinksSource "$links_source" \
  --argjson tokens "${tokens_json:-null}" \
  '{ok:$ok, exitCode:$exitCode, sessionId:$sessionId, tool:$tool,
    costMeasured:$costMeasured, terminalReason:$terminalReason,
    subtype:$subtype, durationSec:$durationSec, branch:$branch,
    push:$push,
    branchUrl:(if $branchUrl == "" then null else $branchUrl end),
    branchUrls:$branchUrls,
    prUrl:(if $prUrl == "" then null else $prUrl end),
    prError:(if $prError == "" then null else $prError end),
    pushError:(if $pushError == "" then null else $pushError end),
    pullError:(if $pullError == "" then null else $pullError end),
    repos:$repos, error:(if $error == "" then null else $error end)}
   # ABSENT, not null, when there is no answer: the reader renames a job
   # to what this names, and "the field is not there" is the only shape
   # that cannot be mistaken for a folder called nothing.
   + (if $specFolder == "" then {} else {specFolder:$specFolder} end)
   # The same rule again, for the same reason (spec 118): a token count
   # is measured or it is not there. A zero would read as "this step
   # used nothing", which is a claim, and the page shows a dash for a
   # field that is absent.
   + (if $tokens == null then {} else {tokens:$tokens} end)
   # And the same rule once more, for the dollar figure itself: a Codex
   # step reports none, and an absent field is the only shape that
   # cannot be added up as if it were a real zero.
   + (if $costUsd == null then {} else {costUsd:$costUsd} end)
   # And once more for which of the two files the worktree links were
   # read from (spec 184): absent means none were configured at all,
   # which is not the same claim as either file naming an empty list.
   + (if $worktreeLinksSource == "" then {} else {worktreeLinksSource:$worktreeLinksSource} end)')"

# The result file is written LAST and by rename, so a reader never sees a
# half-written one — and it is written on every path, including a stop:
# a detached child has no pipe home, so this file is the contract.
#
# Nothing is switched back: the main checkouts were put on their default
# branch before the worktrees were made and never left it. The work stays
# on the spec branch, which is what a reviewer looks at, and the
# worktrees go with the EXIT trap.
printf '%s\n' "$line" > "$result_file.tmp" && mv "$result_file.tmp" "$result_file"
printf '%s\n' "$line"
exit 0
