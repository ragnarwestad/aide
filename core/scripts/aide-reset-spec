#!/usr/bin/env bash
# aide-reset-spec — the mechanical whole of /aide-reset: put an ACTIVE
# spec's work round back to the start by writing 2-analysis.md,
# 3-solution.md and 4-status.md fresh from the templates, leaving
# 0-README.md and 1-description.md byte for byte as they were.
#
# No model is needed for this, so aide-run-spec runs it directly for a
# headless `reset` step (the way it already writes a create with no
# model), and a person running /aide-reset at a keyboard calls it too.
# The `**Reset:**` boundary mark is NOT written here: aide-run-spec
# stamps it once the step finishes, from the specs repository's own
# default-branch tip (run-spec-boundary.sh).
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, specFolder?, files?}
#
# terminalReason: refused | reset
#
# Usage:
#   aide-reset-spec --specs-root <path> --spec <arg> [--result-file <path>]
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"

specs_root=""; spec_arg=""; result_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

emit() {
  printf '%s\n' "$1"
  if [ -n "$result_file" ]; then printf '%s\n' "$1" > "$result_file"; fi
  return 0
}
refuse() {
  emit "$(jq -cn --arg e "$1" '{ok:false,exitCode:2,terminalReason:"refused",error:$e}')"
  exit 2
}

[ -n "$specs_root" ] || refuse "missing --specs-root"
[ -n "$spec_arg" ] || refuse "missing --spec"
[ -d "$specs_root" ] || refuse "no such specs root: $specs_root"
declare -f aide_resolve_spec >/dev/null 2>&1 || refuse "_aide-spec-lib.sh is missing beside aide-reset-spec — reinstall aide"

folder="$(aide_resolve_spec "$spec_arg" "$specs_root")"
[ -n "$folder" ] && [ -d "$specs_root/$folder" ] || refuse "unknown spec: $spec_arg (no active folder under $specs_root)"
case "$folder" in
  archive/*) refuse "$folder is archived — reset is for an active spec; use reopen" ;;
esac
dest="$specs_root/$folder"
[ -f "$dest/1-description.md" ] || refuse "$folder has no 1-description.md to keep"

# The title as 1-description.md's own heading carries it ("# TITLE - Description").
title="$(sed -n '1s/^# //; 1s/ - Description$//p' "$dest/1-description.md")"
[ -n "$title" ] || title="$folder"

aide_write_placeholder_files "$dest" "$title" "$folder"

emit "$(jq -cn --arg f "$folder" --argjson files '["2-analysis.md","3-solution.md","4-status.md"]' \
  '{ok:true,exitCode:0,terminalReason:"reset",specFolder:$f,files:$files}')"
exit 0
