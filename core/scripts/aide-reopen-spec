#!/usr/bin/env bash
# aide-reopen-spec — the mechanical whole of a reopen when the files are
# kept: an ARCHIVED (or closed) spec comes back out of archive/ and nothing
# in it is regenerated. 0-README.md, 1-description.md, 2-analysis.md and
# 3-solution.md stay byte for byte, and 4-status.md changes in exactly two
# places — `archive` leaves the `Workflow steps completed:` line, and one
# `**Round boundary:**` line is appended. The spec's state file follows the
# steps line; it is written through spec-transitions.sh, never here.
#
# With --reset-files the analysis, the plan and the status are written
# fresh from the templates instead (aide-reset-spec), and the status gets
# a `**Reopened:**` mark at the boundary, so the earlier round's steps stop
# counting. The boundary is --boundary, or the specs repository's HEAD.
#
# No model is needed, so aide-run-spec runs this directly for a `reopen`.
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, specFolder?}
#
# terminalReason: refused | reopened
#
# Usage:
#   aide-reopen-spec --specs-root <path> --spec <arg> [--boundary <sha>] [--reset-files] [--result-file <path>]
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/spec-commands/find-spec.sh" ] && source "$SCRIPT_DIR/lib/spec-commands/find-spec.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/spec-transitions.sh" ] && source "$SCRIPT_DIR/lib/spec-transitions.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/spec-result.sh"

specs_root=""; spec_arg=""; boundary=""; result_file=""; reset_files=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'USAGE'
Usage:
  aide-reopen-spec --specs-root <path> --spec <arg> [--boundary <sha>] [--reset-files] [--result-file <path>]
USAGE
      exit 0 ;;
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --boundary) boundary="${2:-}"; shift 2 ;;
    --reset-files) reset_files="yes"; shift ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) aide_spec_refuse "unknown argument: $1" ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

[ -n "$specs_root" ] || aide_spec_refuse "missing --specs-root"
[ -n "$spec_arg" ] || aide_spec_refuse "missing --spec"
[ -d "$specs_root" ] || aide_spec_refuse "no such specs root: $specs_root"
declare -f aide_resolve_spec >/dev/null 2>&1 || aide_spec_refuse "_aide-spec-lib.sh is missing beside aide-reopen-spec — reinstall aide"
declare -f aide_existing_spec >/dev/null 2>&1 || aide_spec_refuse "lib/spec-commands/find-spec.sh is missing beside aide-reopen-spec — reinstall aide"
declare -f apply_spec_transition >/dev/null 2>&1 || aide_spec_refuse "lib/spec-transitions.sh is missing beside aide-reopen-spec — reinstall aide"

folder="$(aide_existing_spec "$specs_root" "$spec_arg")"
case "$folder" in
  archive/*) ;;
  "") aide_spec_refuse "unknown spec: $spec_arg (not under $specs_root)" ;;
  *) aide_spec_refuse "$folder is already active — nothing to reopen" ;;
esac
name="${folder#archive/}"
[ ! -e "$specs_root/$name" ] || aide_spec_refuse "$name already exists among the active specs"
[ -f "$specs_root/$folder/4-status.md" ] || aide_spec_refuse "$folder has no 4-status.md"

# Before the move, so a refusal leaves the folder where it was.
if [ -n "$reset_files" ]; then
  [ -n "$boundary" ] || boundary="$(git -C "$specs_root" rev-parse --short HEAD 2>/dev/null)"
  [ -n "$boundary" ] || aide_spec_refuse "no boundary: pass --boundary, or keep the specs root in git"
fi

if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$specs_root" mv "$folder" "$name" || aide_spec_refuse "cannot move $folder out of archive/"
else
  mv "$specs_root/$folder" "$specs_root/$name" || aide_spec_refuse "cannot move $folder out of archive/"
fi

if [ -n "$reset_files" ]; then
  # The template's status file has no archive trail; carry it over.
  trail="$(grep -E '^\*\*(Archived|Closed):\*\*' "$specs_root/$name/4-status.md" 2>/dev/null)"
  reset_result="$("$SCRIPT_DIR/aide-reset-spec" --specs-root "$specs_root" --spec "$name" 2>/dev/null)"
  [ "$(jq -r '.ok // false' <<<"$reset_result" 2>/dev/null)" = "true" ] \
    || aide_spec_refuse "$(jq -r '.error // "aide-reset-spec refused"' <<<"$reset_result" 2>/dev/null)"
  [ -n "$trail" ] && printf '\n%s\n' "$trail" >> "$specs_root/$name/4-status.md"
  apply_spec_transition "$specs_root/$name/4-status.md" reopen "$boundary"
else
  apply_spec_transition "$specs_root/$name/4-status.md" reopen-keep "$boundary"
fi

# Staged like the move, so a caller that commits what git mv staged takes
# the edited status file and its state along in the same commit.
if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$specs_root" add -A -- "$name" 2>/dev/null
fi

aide_spec_emit_line "$(jq -cn --arg f "$name" '{ok:true,exitCode:0,terminalReason:"reopened",specFolder:$f}')"
exit 0
