#!/usr/bin/env bash
# aide-reopen-spec — the mechanical whole of /aide-reopen when the files are
# kept: an ARCHIVED (or closed) spec comes back out of archive/ and nothing
# in it is regenerated. 0-README.md, 1-description.md, 2-analysis.md and
# 3-solution.md stay byte for byte, and 4-status.md changes in exactly two
# places — `archive` leaves the `Workflow steps completed:` line, and one
# `**Round boundary:**` line is appended. The spec's state file follows the
# steps line; it is written through spec-transitions.sh, never here.
#
# No model is needed, so aide-run-spec runs this directly for a headless
# `reopen` without --reset-files (the way it runs aide-reset-spec for a
# reset), and a person running /aide-reopen at a keyboard calls it too. The
# reset mode (analysis, plan and status back to templates) is the skill's.
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, specFolder?}
#
# terminalReason: refused | reopened
#
# Usage:
#   aide-reopen-spec --specs-root <path> --spec <arg> [--boundary <sha>] [--result-file <path>]
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/spec-transitions.sh" ] && source "$SCRIPT_DIR/lib/spec-transitions.sh"

specs_root=""; spec_arg=""; boundary=""; result_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'USAGE'
Usage:
  aide-reopen-spec --specs-root <path> --spec <arg> [--boundary <sha>] [--result-file <path>]
USAGE
      exit 0 ;;
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --boundary) boundary="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

emit() {
  printf '%s\n' "$1"
  if [ -n "$result_file" ]; then printf '%s\n' "$1" > "$result_file"; fi
  return 0
}
refuse() {
  emit "$(jq -cn --arg e "$1" '{ok:false,exitCode:2,terminalReason:"refused",error:$e}')"
  exit 2
}

[ -n "$specs_root" ] || refuse "missing --specs-root"
[ -n "$spec_arg" ] || refuse "missing --spec"
[ -d "$specs_root" ] || refuse "no such specs root: $specs_root"
declare -f aide_resolve_spec >/dev/null 2>&1 || refuse "_aide-spec-lib.sh is missing beside aide-reopen-spec — reinstall aide"
declare -f apply_spec_transition >/dev/null 2>&1 || refuse "lib/spec-transitions.sh is missing beside aide-reopen-spec — reinstall aide"

folder="$(aide_resolve_spec "$spec_arg" "$specs_root")"
# A full folder name resolves to itself, whichever side of archive/ it is on.
case "$folder" in
  ""|archive/*) ;;
  *) [ -d "$specs_root/$folder" ] || { [ -d "$specs_root/archive/$folder" ] && folder="archive/$folder"; } ;;
esac
case "$folder" in
  archive/*) ;;
  "") refuse "unknown spec: $spec_arg (not under $specs_root)" ;;
  *) refuse "$folder is already active — nothing to reopen" ;;
esac
[ -d "$specs_root/$folder" ] || refuse "unknown spec: $spec_arg (no folder $folder under $specs_root)"
name="${folder#archive/}"
[ ! -e "$specs_root/$name" ] || refuse "$name already exists among the active specs"
[ -f "$specs_root/$folder/4-status.md" ] || refuse "$folder has no 4-status.md"

if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$specs_root" mv "$folder" "$name" || refuse "cannot move $folder out of archive/"
else
  mv "$specs_root/$folder" "$specs_root/$name" || refuse "cannot move $folder out of archive/"
fi

apply_spec_transition "$specs_root/$name/4-status.md" reopen-keep "$boundary"

# Staged like the move, so a caller that commits what git mv staged takes
# the edited status file and its state along in the same commit.
if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git -C "$specs_root" add -A -- "$name" 2>/dev/null
fi

emit "$(jq -cn --arg f "$name" '{ok:true,exitCode:0,terminalReason:"reopened",specFolder:$f}')"
exit 0
