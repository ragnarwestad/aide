#!/usr/bin/env bash
# aide-record-test-run — runs a project's resolved test command(s) and
# writes the ONLY record `aide-archive-spec`'s test-record gate trusts:
# the command, its real exit code, and the commit it ran against. The
# caller resolves WHICH command(s) (via aide-resolve-test-cmd, same rule
# every caller shares); this script is the only thing that
# captures whether they passed.
#
# `--cmd` is repeatable. Exactly one `--cmd` keeps today's exact record
# shape (`command`/`exitCode` as scalars) — this is the regression
# lock, byte for byte. Two or more `--cmd` writes an aggregate record
# instead (`command`/`exitCode` at top level become the aggregate,
# `commands` names every command that ran with its own exit code).
# Every command runs regardless of an earlier one's failure, so a reader
# can see the status of all of them, not just the first failure.
#
# Prints ONE JSON line to stdout and, if given, to --result-file, and
# exits with the SAME code the test command itself produced (0 = passed),
# or the aggregate exit code (0 only if every command's is) for two or
# more. A --project-dir/--specs-root/--folder problem, or a failed record
# write, is a REFUSAL (exitCode 2) — never reported as if it were a
# passing (or even a run) test, since the calling skill ticks its row
# off this exit code alone.
#   single --cmd:  {ok, exitCode, commit, command, terminalReason}
#   2+ --cmd:      {ok, exitCode, commit, command:null, commands, terminalReason}
#
# Usage:
#   aide-record-test-run --project-dir <path> --specs-root <path> \
#     --folder <NN-slug> --cmd "<command, or empty for none found>" \
#     [--cmd "<command>" ...] [--result-file <path>]

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_aide-spec-lib.sh
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"
source "$SCRIPT_DIR/lib/spec-result.sh"

project_dir=""; specs_root=""; folder=""; result_file=""; progress_file=""
cmds=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'USAGE'
Usage:
  aide-record-test-run --project-dir <path> --specs-root <path> \
    --folder <NN-slug> --cmd "<command, or empty for none found>" \
    [--cmd "<command>" ...] [--result-file <path>] [--progress-file <path>]
USAGE
      exit 0 ;;
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --folder) folder="${2:-}"; shift 2 ;;
    --cmd) cmds+=("${2:-}"); shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    --progress-file) progress_file="${2:-}"; shift 2 ;;
    *) aide_spec_refuse "unknown argument: $1" ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

# shellcheck source=/dev/null
# The one reading of which tests a red run failed, for the runner and the
# landing alike: it rides on this script's answer as `failingTests`.
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/failing-tests.sh"

[ -n "$project_dir" ] || aide_spec_refuse "missing --project-dir"
[ -n "$specs_root" ] || aide_spec_refuse "missing --specs-root"
[ -n "$folder" ] || aide_spec_refuse "missing --folder"
[ -d "$project_dir" ] || aide_spec_refuse "no such --project-dir: $project_dir"

target_dir="$specs_root/$folder"
[ -d "$target_dir" ] || aide_spec_refuse "no such spec folder: $folder"

commit="$(git -C "$project_dir" rev-parse HEAD 2>/dev/null || echo "")"
# The tree the commands are about to run against — what aide-run-spec
# compares its own view of the step's result with before deciding
# whether this record already covers it.
tree=""
declare -f aide_tree_hash >/dev/null 2>&1 && tree="$(aide_tree_hash "$project_dir" 2>/dev/null || echo "")"
record_file="$target_dir/test-run.json"

# Everything the commands print, both streams, kept to read the failing
# tests from once they are done.
output_file="$(mktemp)"
trap 'rm -f "$output_file" "$output_file.rc"' EXIT

# One command, run in the project. Its two streams pass through as they
# are, and into $output_file. With --progress-file they pass through
# whole, and the lines that say how far it has come are written to the
# file as they arrive.
run_cmd() {   # <command>
  if [ -z "$progress_file" ]; then
    { { ( cd "$project_dir" && bash -c "$1" ); echo $? > "$output_file.rc"; } 2>&1 1>&3 3>&- \
        | tee -a "$output_file" >&2 3>&-; } 3>&1 | tee -a "$output_file"
    return "$(cat "$output_file.rc" 2>/dev/null || echo 1)"
  fi
  printf 'running %s\n' "$1" >> "$progress_file"
  ( cd "$project_dir" && bash -c "$1" ) 2>&1 | tee -a "$output_file" | LC_ALL=C awk -v out="$progress_file" '
    function note(s) { print s >> out; fflush(out) }
    { print; fflush() }
    /\[ *[0-9]+%\][ \t]*$/ {
      if (match($0, /[0-9]+%\][ \t]*$/)) {
        b = int((substr($0, RSTART) + 0) / 10) * 10
        if (b > last) { last = b; note("pytest " b "%") }
      }
    }
    /^=+ .*[0-9]+ (passed|failed|errors?)/ { s = $0; gsub(/^=+ +| +=+$/, "", s); note("pytest: " s); last = 0 }
    /^bash scripts\/run-tests\.sh/ { note("starting " substr($0, 6)) }
    /^--- / && !/in full:$/ { note(substr($0, 5)) }
    /^\.\.\. [0-9]+ s, / { note(substr($0, 5)) }
    /^red: / { note($0) }
  '
  return "${PIPESTATUS[0]}"
}

# `{failingTests: …}` for a red run, `{}` for a green one.
failing_tests_of_run() {   # <exit code>
  if [ "$1" -eq 0 ]; then echo '{}'; return; fi
  jq -c '{failingTests: .}' <<<"$(failing_tests "$output_file")" 2>/dev/null || echo '{}'
}

if [ "${#cmds[@]}" -le 1 ]; then
  # --- today's exact single-command shape (byte for byte) ---------
  cmd="${cmds[0]:-}"
  if [ -z "$cmd" ]; then
    exit_code=""
    note="no test command configured or detectable for this project"
  else
    run_cmd "$cmd"
    exit_code=$?
    note=""
  fi

  tmp_record="$(mktemp)"
  if ! jq -cn --arg cmd "$cmd" --arg commit "$commit" --arg tree "$tree" \
       --argjson exitCode "${exit_code:-null}" --arg note "$note" \
       '{command: ($cmd | if . == "" then null else . end), exitCode: $exitCode,
         commit: $commit, tree: ($tree | if . == "" then null else . end),
         note: ($note | if . == "" then null else . end)}' \
       > "$tmp_record" || ! mv "$tmp_record" "$record_file"; then
    rm -f "$tmp_record"
    aide_spec_refuse "failed to write test-run.json"
  fi
  [ -f "$record_file" ] || aide_spec_refuse "test-run.json was not written"

  line="$(jq -cn --argjson e "${exit_code:-1}" --arg c "$commit" --arg cmd "$cmd" --argjson f "$(failing_tests_of_run "${exit_code:-0}")" \
    '{ok:true, exitCode:$e, commit:$c, command: ($cmd | if . == "" then null else . end), terminalReason:"recorded"} + $f')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit "${exit_code:-1}"
fi

# --- two or more --cmd: the aggregate record -----------------------
# Every command runs regardless of an earlier one's failure, so a reader
# can see the status of all of them, not just the first that failed.
results_json="[]"
agg_exit=0
command_index=0
for c in "${cmds[@]}"; do
  command_index=$((command_index + 1))
  printf '%s\n' "--- aide test command: $command_index"
  run_cmd "$c"
  ec=$?
  [ "$ec" -ne 0 ] && agg_exit="$ec"
  results_json="$(jq -cn --argjson prev "$results_json" --arg cmd "$c" --argjson ec "$ec" \
    '$prev + [{command:$cmd, exitCode:$ec}]')"
done

tmp_record="$(mktemp)"
if ! jq -cn --arg commit "$commit" --arg tree "$tree" --argjson exitCode "$agg_exit" --argjson commands "$results_json" \
     '{command: null, exitCode: $exitCode, commit: $commit, tree: ($tree | if . == "" then null else . end),
       note: null, commands: $commands}' \
     > "$tmp_record" || ! mv "$tmp_record" "$record_file"; then
  rm -f "$tmp_record"
  aide_spec_refuse "failed to write test-run.json"
fi
[ -f "$record_file" ] || aide_spec_refuse "test-run.json was not written"

line="$(jq -cn --argjson e "$agg_exit" --arg c "$commit" --argjson commands "$results_json" --argjson f "$(failing_tests_of_run "$agg_exit")" \
  '{ok:true, exitCode:$e, commit:$c, command:null, commands:$commands, terminalReason:"recorded"} + $f')"
printf '%s\n' "$line"
[ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
exit "$agg_exit"
