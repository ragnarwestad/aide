#!/usr/bin/env bash
# aide-record-test-run — runs a project's resolved test command(s) and
# writes the ONLY record `aide-archive-spec`'s test-record gate trusts:
# the command, its real exit code, and the commit it ran against. The
# caller resolves WHICH command(s) (via aide-resolve-test-cmd, same rule
# every caller shares — spec 361); this script is the only thing that
# captures whether they passed.
#
# `--cmd` is repeatable. Exactly one `--cmd` keeps today's exact record
# shape (`command`/`exitCode` as scalars) — this is REQ-6's regression
# lock, byte for byte. Two or more `--cmd` writes an aggregate record
# instead (`command`/`exitCode` at top level become the aggregate,
# `commands` names every command that ran with its own exit code — REQ-5).
# Every command runs regardless of an earlier one's failure, so a reader
# can see the status of all of them, not just the first failure.
#
# Prints ONE JSON line to stdout and, if given, to --result-file, and
# exits with the SAME code the test command itself produced (0 = passed),
# or the aggregate exit code (0 only if every command's is) for two or
# more. A --project-dir/--specs-root/--folder problem, or a failed record
# write, is a REFUSAL (exitCode 2) — never reported as if it were a
# passing (or even a run) test, since the calling skill ticks its row
# off this exit code alone.
#   single --cmd:  {ok, exitCode, commit, command, terminalReason}
#   2+ --cmd:      {ok, exitCode, commit, command:null, commands, terminalReason}
#
# Usage:
#   aide-record-test-run --project-dir <path> --specs-root <path> \
#     --folder <NN-slug> --cmd "<command, or empty for none found>" \
#     [--cmd "<command>" ...] [--result-file <path>]

set -uo pipefail

project_dir=""; specs_root=""; folder=""; result_file=""
cmds=()

while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --specs-root) specs_root="${2:-}"; shift 2 ;;
    --folder) folder="${2:-}"; shift 2 ;;
    --cmd) cmds+=("${2:-}"); shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

refuse() {
  local msg="$1" line
  line="$(jq -cn --arg e "$msg" '{ok:false, exitCode:2, terminalReason:"refused", error:$e}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 2
}

[ -n "$project_dir" ] || refuse "missing --project-dir"
[ -n "$specs_root" ] || refuse "missing --specs-root"
[ -n "$folder" ] || refuse "missing --folder"
[ -d "$project_dir" ] || refuse "no such --project-dir: $project_dir"

target_dir="$specs_root/$folder"
[ -d "$target_dir" ] || refuse "no such spec folder: $folder"

commit="$(git -C "$project_dir" rev-parse HEAD 2>/dev/null || echo "")"
record_file="$target_dir/test-run.json"

if [ "${#cmds[@]}" -le 1 ]; then
  # --- today's exact single-command shape (REQ-6, byte for byte) ---------
  cmd="${cmds[0]:-}"
  if [ -z "$cmd" ]; then
    exit_code=""
    note="no test command configured or detectable for this project"
  else
    ( cd "$project_dir" && bash -c "$cmd" )
    exit_code=$?
    note=""
  fi

  tmp_record="$(mktemp)"
  if ! jq -cn --arg cmd "$cmd" --arg commit "$commit" \
       --argjson exitCode "${exit_code:-null}" --arg note "$note" \
       '{command: ($cmd | if . == "" then null else . end), exitCode: $exitCode,
         commit: $commit, note: ($note | if . == "" then null else . end)}' \
       > "$tmp_record" || ! mv "$tmp_record" "$record_file"; then
    rm -f "$tmp_record"
    refuse "failed to write test-run.json"
  fi
  [ -f "$record_file" ] || refuse "test-run.json was not written"

  line="$(jq -cn --argjson e "${exit_code:-1}" --arg c "$commit" --arg cmd "$cmd" \
    '{ok:true, exitCode:$e, commit:$c, command: ($cmd | if . == "" then null else . end), terminalReason:"recorded"}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit "${exit_code:-1}"
fi

# --- two or more --cmd: the aggregate record (REQ-5) -----------------------
# Every command runs regardless of an earlier one's failure, so a reader
# can see the status of all of them, not just the first that failed.
results_json="[]"
agg_exit=0
for c in "${cmds[@]}"; do
  ( cd "$project_dir" && bash -c "$c" )
  ec=$?
  [ "$ec" -ne 0 ] && agg_exit="$ec"
  results_json="$(jq -cn --argjson prev "$results_json" --arg cmd "$c" --argjson ec "$ec" \
    '$prev + [{command:$cmd, exitCode:$ec}]')"
done

tmp_record="$(mktemp)"
if ! jq -cn --arg commit "$commit" --argjson exitCode "$agg_exit" --argjson commands "$results_json" \
     '{command: null, exitCode: $exitCode, commit: $commit, note: null, commands: $commands}' \
     > "$tmp_record" || ! mv "$tmp_record" "$record_file"; then
  rm -f "$tmp_record"
  refuse "failed to write test-run.json"
fi
[ -f "$record_file" ] || refuse "test-run.json was not written"

line="$(jq -cn --argjson e "$agg_exit" --arg c "$commit" --argjson commands "$results_json" \
  '{ok:true, exitCode:$e, commit:$c, command:null, commands:$commands, terminalReason:"recorded"}')"
printf '%s\n' "$line"
[ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
exit "$agg_exit"
