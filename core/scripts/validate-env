#!/bin/bash
# validate-env - Validates required environment variables for aide
#
# Usage:
#   validate-env           # Check all variables
#   validate-env --quiet   # Quiet mode (exit codes only)
#   validate-env --fix     # Show fix instructions

# Do not use set -e because (( var++ )) returns 1 when var=0

QUIET=false
FIX=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --quiet|-q)
            QUIET=true
            shift
            ;;
        --fix|-f)
            FIX=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

errors=0
warnings=0

# Function to check a required variable
check_required() {
    local var_name=$1
    local description=$2

    if [ -z "${!var_name}" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${RED}❌ $var_name is not set${NC}"
            echo "   $description"
        fi
        ((errors++))
    else
        if [ "$QUIET" = false ]; then
            echo -e "${GREEN}✅ $var_name${NC} = ${!var_name}"
        fi
    fi
}

# Function to check an optional variable
check_optional() {
    local var_name=$1
    local description=$2

    if [ -z "${!var_name}" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${YELLOW}⚠️  $var_name is not set (optional)${NC}"
            echo "   $description"
        fi
        ((warnings++))
    else
        if [ "$QUIET" = false ]; then
            echo -e "${GREEN}✅ $var_name${NC} = ${!var_name}"
        fi
    fi
}

# Function to check that a path exists
check_path_exists() {
    local var_name=$1
    local path="${!var_name}"

    if [ -n "$path" ] && [ ! -d "$path" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${RED}   ⚠️  Path does not exist: $path${NC}"
        fi
        ((warnings++))
    fi
}

if [ "$QUIET" = false ]; then
    echo "========================================"
    echo "Environment variable validation for aide"
    echo "========================================"
    echo ""
    echo "📋 Required variables:"
    echo ""
fi

# Required variables
check_required "AIDE_INSTALLATION_PATH" "Path to the aide workspace root"
check_path_exists "AIDE_INSTALLATION_PATH"

if [ "$QUIET" = false ]; then
    echo ""
    echo "📋 Optional variables:"
    echo ""
fi

# Optional variables
check_optional "AIDE_REPORTS_PATH" "External path for reports (JIRA/TODO documentation)"
check_path_exists "AIDE_REPORTS_PATH"

check_optional "OPENAI_API_KEY" "API key for OpenAI Codex"
check_optional "ANTHROPIC_API_KEY" "API key for Claude"

if [ "$QUIET" = false ]; then
    echo ""
    echo "========================================"

    if [ $errors -gt 0 ]; then
        echo -e "${RED}❌ $errors errors found${NC}"
    fi

    if [ $warnings -gt 0 ]; then
        echo -e "${YELLOW}⚠️  $warnings warnings${NC}"
    fi

    if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
        echo -e "${GREEN}✅ All variables are set correctly${NC}"
    fi
    echo "========================================"
fi

# Show fix instructions if --fix
if [ "$FIX" = true ] && [ $errors -gt 0 ]; then
    echo ""
    echo "🔧 To fix, add to ~/.zshrc or ~/.bashrc:"
    echo ""
    echo "# aide environment variables"

    if [ -z "$AIDE_INSTALLATION_PATH" ]; then
        echo "export AIDE_INSTALLATION_PATH=\"/Users/\$(whoami)/develop/aide\""
    fi

    echo ""
    echo "# Optional: External reports path"
    echo "# export AIDE_REPORTS_PATH=\"/Users/\$(whoami)/Documents/aide-reports\""
    echo ""
    echo "Then run: source ~/.zshrc"
fi

# Exit with an error code only if required variables are missing
if [ $errors -gt 0 ]; then
    exit 1
else
    exit 0
fi
