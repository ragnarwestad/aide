#!/bin/bash
# validate-env - Validerer påkrevde miljøvariabler for {{domain}}-aide
#
# Bruk:
#   validate-env           # Sjekk alle variabler
#   validate-env --quiet   # Stille modus (kun feilkoder)
#   validate-env --fix     # Vis fikse-instruksjoner

# Ikke bruk set -e fordi (( var++ )) returnerer 1 når var=0

QUIET=false
FIX=false

# Parse argumenter
while [[ $# -gt 0 ]]; do
    case $1 in
        --quiet|-q)
            QUIET=true
            shift
            ;;
        --fix|-f)
            FIX=true
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Farger
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

errors=0
warnings=0

# Funksjon for å sjekke påkrevd variabel
check_required() {
    local var_name=$1
    local description=$2

    if [ -z "${!var_name}" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${RED}❌ $var_name er ikke satt${NC}"
            echo "   $description"
        fi
        ((errors++))
    else
        if [ "$QUIET" = false ]; then
            echo -e "${GREEN}✅ $var_name${NC} = ${!var_name}"
        fi
    fi
}

# Funksjon for å sjekke valgfri variabel
check_optional() {
    local var_name=$1
    local description=$2

    if [ -z "${!var_name}" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${YELLOW}⚠️  $var_name er ikke satt (valgfri)${NC}"
            echo "   $description"
        fi
        ((warnings++))
    else
        if [ "$QUIET" = false ]; then
            echo -e "${GREEN}✅ $var_name${NC} = ${!var_name}"
        fi
    fi
}

# Funksjon for å sjekke at path eksisterer
check_path_exists() {
    local var_name=$1
    local path="${!var_name}"

    if [ -n "$path" ] && [ ! -d "$path" ]; then
        if [ "$QUIET" = false ]; then
            echo -e "${RED}   ⚠️  Path eksisterer ikke: $path${NC}"
        fi
        ((warnings++))
    fi
}

if [ "$QUIET" = false ]; then
    echo "========================================"
    echo "Miljøvariabel-validering for {{domain}}-aide"
    echo "========================================"
    echo ""
    echo "📋 Påkrevde variabler:"
    echo ""
fi

# Påkrevde variabler
check_required "{{DOMAIN}}_AIDE_INSTALLATION_PATH" "Path til {{domain}}-aide workspace-roten"
check_path_exists "{{DOMAIN}}_AIDE_INSTALLATION_PATH"

if [ "$QUIET" = false ]; then
    echo ""
    echo "📋 Valgfrie variabler:"
    echo ""
fi

# Valgfrie variabler
check_optional "{{DOMAIN}}_AIDE_REPORTS_PATH" "Ekstern path for reports (JIRA/TODO dokumentasjon)"
check_path_exists "{{DOMAIN}}_AIDE_REPORTS_PATH"

check_optional "OPENAI_API_KEY" "API-nøkkel for OpenAI Codex"
check_optional "ANTHROPIC_API_KEY" "API-nøkkel for Claude"

if [ "$QUIET" = false ]; then
    echo ""
    echo "========================================"

    if [ $errors -gt 0 ]; then
        echo -e "${RED}❌ $errors feil funnet${NC}"
    fi

    if [ $warnings -gt 0 ]; then
        echo -e "${YELLOW}⚠️  $warnings advarsler${NC}"
    fi

    if [ $errors -eq 0 ] && [ $warnings -eq 0 ]; then
        echo -e "${GREEN}✅ Alle variabler er korrekt satt${NC}"
    fi
    echo "========================================"
fi

# Vis fikse-instruksjoner hvis --fix
if [ "$FIX" = true ] && [ $errors -gt 0 ]; then
    echo ""
    echo "🔧 For å fikse, legg til i ~/.zshrc eller ~/.bashrc:"
    echo ""
    echo "# {{domain}}-aide miljøvariabler"

    if [ -z "${{DOMAIN}}_AIDE_INSTALLATION_PATH" ]; then
        echo "export {{DOMAIN}}_AIDE_INSTALLATION_PATH=\"/Users/\$(whoami)/develop/{{domain}}-aide\""
    fi

    echo ""
    echo "# Valgfritt: Ekstern reports-path"
    echo "# export {{DOMAIN}}_AIDE_REPORTS_PATH=\"/Users/\$(whoami)/Documents/{{domain}}-reports\""
    echo ""
    echo "Kjør deretter: source ~/.zshrc"
fi

# Exit med feilkode kun hvis påkrevde variabler mangler
if [ $errors -gt 0 ]; then
    exit 1
else
    exit 0
fi
