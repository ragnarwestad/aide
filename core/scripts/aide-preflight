#!/usr/bin/env bash
# aide-preflight - Probe what is actually installed before installing aide.
#
# Reports, per AI tool: whether the CLI is on PATH (and its version), and
# where each aide piece will land. Informational only — always exits 0 for
# known tools, so installers can run it without aborting. A missing tool is
# fine: the files install anyway and take effect once the tool arrives.
#
# Usage:
#   aide-preflight            # all tools
#   aide-preflight all
#   aide-preflight claude
#   aide-preflight copilot
#   aide-preflight codex
#   aide-preflight opencode
#   aide-preflight --facts claude   # what the board reads, one fact per line

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Whether a CLI is on PATH.
cli_found() {
  command -v "$1" >/dev/null 2>&1
}

# Probe a CLI: print found+version or a not-found warning. Never fails.
probe() {
  local label="$1" cmd="$2" version
  if cli_found "$cmd"; then
    version="$("$cmd" --version 2>/dev/null | head -1)"
    echo -e "${GREEN}✅ $label found${NC} (${version:-version unknown})"
  else
    echo -e "${YELLOW}⚠️  $label not found on PATH${NC} — files install anyway and take effect once it is installed"
  fi
}

# Whether a place from the table exists on this machine.
place_exists() {
  [ -e "$(target_path "$1")" ]
}

# "exists" or "new" for a place from the table
state() {
  if place_exists "$1"; then echo "exists, will be updated"; else echo "new"; fi
}

# Where aide installs for each AI: one table, which the dashboard's
# Settings tabs read too. Beside this script in the repository and under
# ~/.local/bin alike.
TARGETS="$(cd "$(dirname "$0")" && pwd)/lib/install-targets.txt"

# A place from the table as a path on this machine.
target_path() {
  case "$1" in
    \~/.config/*) echo "${XDG_CONFIG_HOME:-$HOME/.config}/${1#\~/.config/}" ;;
    \~/*) echo "$HOME/${1#\~/}" ;;
    *) echo "$1" ;;
  esac
}

# A place from the table as the report shows it: under ~/.config/ only
# where $XDG_CONFIG_HOME moves it.
shown_path() {
  case "$1" in
    \~/.config/*) [ -n "${XDG_CONFIG_HOME:-}" ] && { target_path "$1"; return 0; } ;;
  esac
  echo "$1"
}

# Every place the table names for one AI, one line each.
places() {
  local ai="$1" tool place from to shown
  if [ ! -f "$TARGETS" ]; then
    echo "   ⚠️  $TARGETS is missing — cannot say where aide's pieces land"
    return 0
  fi
  while read -r tool place from to; do
    case "$tool" in ''|'#'*) continue ;; esac
    [ "$tool" = "$ai" ] || continue
    shown="$(shown_path "$to")"
    if [ "$from" = "-" ]; then
      printf '   %-38s → %s   (read in place, nothing installed)\n' "$place" "$shown"
    else
      printf '   %-38s → %s   (%s)\n' "$from" "$shown" "$(state "$to")"
    fi
  done < "$TARGETS"
}

# Claude Code keeps one person's settings in .claude/settings.local.json,
# and only git's ignore rules keep the file out of a project's history.
# Warn when git on this machine does not ignore it in every repo, and when
# the repo the preflight runs in tracks it, which no ignore rule undoes.
preflight_local_settings() {
  local file=".claude/settings.local.json" probe_repo top
  cli_found git || return 0
  probe_repo="$(mktemp -d)"
  if git init -q "$probe_repo" 2>/dev/null &&
     ! git -C "$probe_repo" check-ignore -q "$file"; then
    echo -e "   ${YELLOW}⚠️  git on this machine does not ignore $file in every repo${NC} — add **/$file to git's global ignore file (~/.config/git/ignore)"
  fi
  rm -rf "$probe_repo"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  if git -C "$top" ls-files --error-unmatch "$file" >/dev/null 2>&1; then
    echo -e "   ${YELLOW}⚠️  $top tracks $file${NC} — run git rm --cached $file there and commit"
  fi
}

preflight_claude() {
  echo "Claude Code"
  echo "-----------"
  probe "Claude Code" claude
  places claude
  preflight_local_settings
  echo ""
}

preflight_copilot() {
  echo "GitHub Copilot"
  echo "--------------"
  probe "Copilot CLI" copilot
  places copilot
  echo "   Note: the Copilot CLI reads personal skills from ~/.agents/skills/,"
  echo "   not ~/.claude/skills/ (verified against 1.0.79). ~/.claude/rules/ is"
  echo "   NOT read by Copilot; the rules reach it through the instructions file."
  echo ""
}

preflight_opencode() {
  echo ""
  echo "🔧 OpenCode"
  probe "OpenCode" opencode
  places opencode
}

preflight_codex() {
  echo "OpenAI Codex"
  echo "------------"
  probe "Codex CLI" codex
  places codex
  echo ""
}

preflight_optional_deps() {
  echo "Optional CLI dependencies"
  echo "-------------------------"
  probe "pandoc (aide-generate-html)" pandoc
  probe "md-to-pdf (aide-generate-pdf)" md-to-pdf
  echo ""
}

# Whether this machine's ~/.local/bin copy of aide's scripts is behind
# the repo it was installed from, as "<state>|<installed sha>|<current sha>".
# The state is "unknown" when install_common_bin has never stamped one — an
# old install, or a machine that has not installed aide at all — or when the
# repo it names cannot be read, so drift is never claimed that cannot
# actually be measured. This is the one place that decides it.
drift_state() {
  local stamp="$HOME/.local/bin/.aide-installed-version"
  [ -f "$stamp" ] || { echo "unknown||"; return 0; }
  local repo_root installed_sha current_sha
  repo_root="$(sed -n '1p' "$stamp")"
  installed_sha="$(sed -n '2p' "$stamp")"
  # rev-parse (not `[ -d "$repo_root/.git" ]`) so this still works from
  # a git worktree checkout, where .git is a FILE pointing at the real
  # gitdir rather than a directory.
  git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1 || { echo "unknown||"; return 0; }
  current_sha="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || echo unknown)"
  if [ "$installed_sha" = "$current_sha" ]; then
    echo "match|$installed_sha|$current_sha"
  else
    echo "behind|$installed_sha|$current_sha"
  fi
}

# Say whether the installed files are behind the repo. Silent when that
# cannot be measured.
preflight_drift() {
  local state installed_sha current_sha
  IFS='|' read -r state installed_sha current_sha <<< "$(drift_state)"
  [ "$state" = "unknown" ] && return 0
  if [ "$state" = "match" ]; then
    echo -e "${GREEN}✅ Installed files match the repo${NC} ($current_sha)"
  elif [ -n "${AIDE_INSTALLING:-}" ]; then
    # The installer that is running right now is what brings them up:
    # a warning here would fire on every landing, for the one thing
    # the run is in the middle of fixing.
    echo "   Installed files are behind the repo (installed $installed_sha) — this run updates them to $current_sha"
  else
    echo -e "${YELLOW}⚠️  Installed files are behind the repo${NC} (installed $installed_sha, repo now at $current_sha) — press Deploy on the board, which runs the installers"
  fi
  echo ""
}

# The facts the board reads, for one tool: no banner, no colour, one fact
# per line with its fields separated by a tab.
#   cli    found|missing
#   place  <name>  <path as the report shows it>  exists|missing
#   files  match|behind|unknown
preflight_facts() {
  local ai="$1" tool place from to state
  case "$ai" in
    claude|copilot|codex|opencode) ;;
    *)
      echo "Unknown tool: ${ai:-(none)} (use claude, copilot, codex or opencode)" >&2
      return 1 ;;
  esac
  if cli_found "$ai"; then printf 'cli\tfound\n'; else printf 'cli\tmissing\n'; fi
  if [ -f "$TARGETS" ]; then
    while read -r tool place from to; do
      case "$tool" in ''|'#'*) continue ;; esac
      [ "$tool" = "$ai" ] || continue
      if place_exists "$to"; then state=exists; else state=missing; fi
      printf 'place\t%s\t%s\t%s\n' "$place" "$(shown_path "$to")" "$state"
    done < "$TARGETS"
  fi
  IFS='|' read -r state _ _ <<< "$(drift_state)"
  printf 'files\t%s\n' "$state"
}

# The facts come before the banner: they are for a program to read.
if [ "${1:-}" = "--facts" ]; then
  preflight_facts "${2:-}"
  exit $?
fi

TOOL="${1:-all}"

echo "🔎 aide preflight"
echo "================="
echo ""

case "$TOOL" in
  -h|--help)
    sed -n '9,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  claude)  preflight_claude; preflight_drift ;;
  copilot) preflight_copilot; preflight_drift ;;
  codex)   preflight_codex; preflight_drift ;;
  opencode) preflight_opencode; preflight_drift ;;
  all)
    preflight_claude
    preflight_copilot
    preflight_codex
    preflight_opencode
    preflight_optional_deps
    preflight_drift
    ;;
  *)
    echo "❌ Unknown tool: $TOOL (use claude, copilot, codex, opencode or all)"
    exit 1
    ;;
esac

exit 0
