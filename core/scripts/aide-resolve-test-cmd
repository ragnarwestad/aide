#!/usr/bin/env bash
# aide-resolve-test-cmd — the single rule that turns a changeset's
# touched files into the test command(s) that cover them (spec 361).
# Both `aide-archive-spec`'s test-record gate and `/aide-implement`'s
# own Phase 3/Quality check call this literal script, so the gate and a
# person's own run agree on "the tests" by construction, not by two
# independent prose descriptions of the same rule.
#
# No scopes declared in `.aide/config` (no AIDE_TEST_SCOPE_PATHS_1 key):
# resolves to the single legacy AIDE_TEST_CMD, unconditionally, WITHOUT
# ever touching git — REQ-6, byte for byte what a plain project does
# today.
#
# Scopes declared: diffs `git diff --name-only <base-ref>...HEAD`
# (base-ref from aide_test_scope_base_ref, origin-preferring) and
# resolves the file list through aide_test_scope_commands (see
# _aide-spec-lib.sh for the four-step matching rule).
#
# Prints ONE JSON line to stdout:
#   {"ok":true,"commands":["<cmd1>", ...]}   (commands may be empty)
#   {"ok":false,"exitCode":2,"terminalReason":"refused","error":"..."}
#
# A diff/branch-resolution failure is a REFUSAL (exitCode 2) — never an
# empty, silently-"ok" commands array, so a broken worktree cannot make
# a caller skip tests without saying so.
#
# Usage:
#   aide-resolve-test-cmd --project-dir <path>

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"

project_dir=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

refuse() {
  local msg="$1"
  jq -cn --arg e "$msg" '{ok:false, exitCode:2, terminalReason:"refused", error:$e}'
  exit 2
}

[ -n "$project_dir" ] || refuse "missing --project-dir"
[ -d "$project_dir" ] || refuse "no such --project-dir: $project_dir"
git -C "$project_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || refuse "not a git repository: $project_dir"
declare -f aide_test_scope_commands >/dev/null 2>&1 \
  || refuse "aide_test_scope_commands is not available (missing _aide-spec-lib.sh)"

# --- REQ-6 fast path: no scopes declared, no git needed at all -------------
first_paths="$(aide_config_get AIDE_TEST_SCOPE_PATHS_1 "$project_dir")"
if [ -z "$first_paths" ]; then
  legacy="$(aide_config_get AIDE_TEST_CMD "$project_dir")"
  if [ -n "$legacy" ]; then
    jq -cn --arg c "$legacy" '{ok:true, commands:[$c]}'
  else
    jq -cn '{ok:true, commands:[]}'
  fi
  exit 0
fi

# --- scoped path: resolve the changed-file list, then the commands ---------
base_ref="$(aide_test_scope_base_ref "$project_dir")"
[ -n "$base_ref" ] || refuse "could not resolve a base ref for $project_dir"

changed_output="$(git -C "$project_dir" diff --name-only "${base_ref}...HEAD" 2>&1)"
diff_status=$?
[ "$diff_status" -eq 0 ] || refuse "git diff against $base_ref failed: $changed_output"

changed_files=()
while IFS= read -r line; do
  [ -n "$line" ] && changed_files+=("$line")
done <<< "$changed_output"

commands=()
while IFS= read -r c; do
  [ -n "$c" ] && commands+=("$c")
done < <(aide_test_scope_commands "$project_dir" ${changed_files[@]+"${changed_files[@]}"})

jq -cn --args '{ok:true, commands:$ARGS.positional}' -- ${commands[@]+"${commands[@]}"}
