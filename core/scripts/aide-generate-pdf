#!/usr/bin/env bash

# aide-generate-pdf - Generate PDF from JIRA or TODO documentation
# Combines all markdown files into a single PDF document

set -e

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Help text
if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "📄 Usage: aide-generate-pdf <ISSUE_ID> [OUTPUT_PATH]"
  echo ""
  echo "Examples (flat structure):"
  echo "  aide-generate-pdf 35                    # Shorthand: finds 35-todo-ai-nyheter"
  echo "  aide-generate-pdf todo-35               # Alternative shorthand"
  echo "  aide-generate-pdf 35-todo-ai-nyheter    # Full ID"
  echo "  aide-generate-pdf 45-proj-7637          # JIRA-based task"
  echo "  aide-generate-pdf 35 /tmp/out.pdf       # Explicit output path"
  echo ""
  echo "Configuration:"
  echo "  AIDE_SPECS_PATH in <project>/.aide/config - external specs root (optional)"
  echo "  (Default: specs/ in the project root)"
  echo ""
  echo "Output: <docs-folder>/<ISSUE_ID>.pdf, or OUTPUT_PATH when given"
  exit 0
fi

ISSUE_ID="$1"

# Shared helper functions (specs-root, resolution, doc-type, display-name)
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source "$SCRIPT_DIR/_aide-spec-lib.sh"

SPECS_ROOT="$(aide_specs_root)"
FULL_ID="$(aide_resolve_spec "$ISSUE_ID" "$SPECS_ROOT")"
DOCS_DIR="$SPECS_ROOT/$FULL_ID"

# Check that we found something
if [ -z "$FULL_ID" ] || [ ! -d "$DOCS_DIR" ]; then
  echo -e "${RED}❌ Error: No documentation found for: $ISSUE_ID${NC}"
  echo ""
  echo "Searched in: $SPECS_ROOT"
  echo ""
  echo "Tips:"
  echo "  - Have you run /aide-create first?"
  echo "  - Check AIDE_SPECS_PATH in .aide/config in the project root"
  echo ""
  echo "Available folders:"
  ls -1 "$SPECS_ROOT" | grep -E "^[0-9]+-" | head -10
  exit 1
fi

# Use the folder BASENAME for file names — FULL_ID may carry an archive/ prefix,
# and a slash in a file name breaks mktemp and the output path.
ISSUE_ID="${FULL_ID##*/}"
DOC_TYPE="$(aide_doc_type "$FULL_ID")"

# Check that md-to-pdf is installed
if ! command -v md-to-pdf &> /dev/null; then
  echo -e "${RED}❌ Error: md-to-pdf is not installed${NC}"
  echo ""
  echo "Install with:"
  echo "  npm install -g md-to-pdf"
  echo ""
  echo "Or run it without installing:"
  echo "  npx md-to-pdf"
  exit 1
fi

echo -e "${GREEN}📄 Generating PDF for $DOC_TYPE: $ISSUE_ID${NC}"
echo ""

# Create temporary combined markdown file in the system TMP area
# A directory of its own, not a fixed name under /tmp: two runs for the
# same spec at once (the suite runs its tests in parallel) collided on
# the same file. The .md suffix is what md-to-pdf keys its output on.
TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/aide-pdf-XXXXXX")"
TEMP_MD="$TEMP_DIR/combined-${ISSUE_ID}.md"
# $2 is an optional explicit output path (the dashboard's own server
# route uses it to write outside any checkout); the terminal skill's
# one-argument call is unaffected and keeps writing beside the four
# files, exactly as it does today.
OUTPUT_PDF="${2:-$DOCS_DIR/$ISSUE_ID.pdf}"
mkdir -p "$(dirname "$OUTPUT_PDF")"

cleanup() {
  rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

# Start with an empty file
> "$TEMP_MD"

# Front page (metadata for the PDF engine only)
echo "---" >> "$TEMP_MD"
echo "title: \"$ISSUE_ID\"" >> "$TEMP_MD"
echo "date: \"$(date '+%Y-%m-%d')\"" >> "$TEMP_MD"
echo "---" >> "$TEMP_MD"
echo "" >> "$TEMP_MD"

# Function to add the README (without heading, with internal links)
add_readme() {
  if [ -f "$DOCS_DIR/0-README.md" ]; then
    echo -e "${GREEN}  ✅ Table of contents${NC}"

    # Add front page with navigation boxes
    echo "# Table of Contents" >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
    echo '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0;">' >> "$TEMP_MD"
    echo '<a href="#description" style="text-decoration: none; color: inherit;"><div style="border: 2px solid #0066cc; border-radius: 8px; padding: 20px; background: #f0f7ff;"><h2 style="margin: 0 0 10px 0; color: #0066cc;">📋 Description</h2><p style="margin: 0; color: #666;">JIRA data, scope and acceptance criteria</p></div></a>' >> "$TEMP_MD"
    echo '<a href="#analysis" style="text-decoration: none; color: inherit;"><div style="border: 2px solid #0066cc; border-radius: 8px; padding: 20px; background: #f0f7ff;"><h2 style="margin: 0 0 10px 0; color: #0066cc;">🔍 Analysis</h2><p style="margin: 0; color: #666;">Codebase analysis and complexity</p></div></a>' >> "$TEMP_MD"
    echo '<a href="#solution" style="text-decoration: none; color: inherit;"><div style="border: 2px solid #0066cc; border-radius: 8px; padding: 20px; background: #f0f7ff;"><h2 style="margin: 0 0 10px 0; color: #0066cc;">💡 Solution</h2><p style="margin: 0; color: #666;">Implementation plan with TDD</p></div></a>' >> "$TEMP_MD"
    echo '<a href="#status" style="text-decoration: none; color: inherit;"><div style="border: 2px solid #0066cc; border-radius: 8px; padding: 20px; background: #f0f7ff;"><h2 style="margin: 0 0 10px 0; color: #0066cc;">✅ Status</h2><p style="margin: 0; color: #666;">Progress tracking and results</p></div></a>' >> "$TEMP_MD"
    echo '</div>' >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
    echo '<div style="page-break-after: always;"></div>' >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
  else
    echo -e "${YELLOW}  ⏭️  Skipping table of contents (0-README.md does not exist)${NC}"
  fi
}

# Function to add a section with page break (the file already has a heading)
add_section() {
  local file="$1"
  local title="$2"
  local anchor_id=$(echo "$title" | tr '[:upper:]' '[:lower:]')  # description, analysis, etc.

  if [ -f "$DOCS_DIR/$file" ]; then
    echo -e "${GREEN}  ✅ $title${NC}"
    # Page break before the section (HTML for better support in md-to-pdf)
    echo '<div style="page-break-before: always;"></div>' >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
    # Add HTML anchor for internal linking AND context marker for the header
    echo "<!-- SECTION: $title -->" >> "$TEMP_MD"
    echo "<a id=\"$anchor_id\"></a>" >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
    # Include the file directly (it already has its own heading)
    cat "$DOCS_DIR/$file" >> "$TEMP_MD"
    echo "" >> "$TEMP_MD"
  else
    echo -e "${YELLOW}  ⏭️  Skipping $title (file does not exist)${NC}"
  fi
}

# Add all sections
add_readme  # README first (without extra heading)
add_section "1-description.md" "Description"
add_section "2-analysis.md" "Analysis"
add_section "3-solution.md" "Solution"
add_section "4-status.md" "Status"

# Convert cross-document links into internal anchors (otherwise they open externally in the PDF).
# Links with an #anchor keep the anchor; whole-file links are mapped to the section anchor.
sed -E \
  -e 's|\]\((\./)?[0-9]+-[^)#]*\.md#|](#|g' \
  -e 's|\]\((\./)?1-description\.md\)|](#description)|g' \
  -e 's|\]\((\./)?2-analysis\.md\)|](#analysis)|g' \
  -e 's|\]\((\./)?3-solution\.md\)|](#solution)|g' \
  -e 's|\]\((\./)?4-status\.md\)|](#status)|g' \
  "$TEMP_MD" > "${TEMP_MD}.linked" && mv "${TEMP_MD}.linked" "$TEMP_MD"

echo ""
echo -e "${GREEN}📄 Converting to PDF...${NC}"

# Get readable name for the header
DISPLAY_NAME=$(get_display_name "$ISSUE_ID")

# Convert to PDF with md-to-pdf (output directly to the right location)
# Header: Shows only the document name (simple and clean)
# Footer: Page number
md-to-pdf "$TEMP_MD" --pdf-options '{"format": "A4", "margin": {"top": "20mm", "right": "20mm", "bottom": "20mm", "left": "20mm"}, "displayHeaderFooter": true, "headerTemplate": "<div style=\"font-size: 10px; width: 100%; padding: 8px 20px; border-bottom: 1px solid #ccc; background: #f8f8f8;\"><span style=\"font-weight: bold; color: #333;\">'"$DISPLAY_NAME"'</span></div>", "footerTemplate": "<div style=\"font-size: 9px; text-align: center; width: 100%; color: #666; border-top: 1px solid #ddd; padding-top: 5px;\">Page <span class=\"pageNumber\"></span> of <span class=\"totalPages\"></span></div>"}' > /dev/null 2>&1

# Find the generated PDF and move it to the right name/location
TEMP_PDF="${TEMP_MD%.md}.pdf"
if [ -f "$TEMP_PDF" ]; then
  mv "$TEMP_PDF" "$OUTPUT_PDF"
fi

echo ""
echo -e "${GREEN}✅ PDF generated: $OUTPUT_PDF${NC}"
echo ""
echo "Open with:"
echo "  open \"$OUTPUT_PDF\""
