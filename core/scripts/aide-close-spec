#!/usr/bin/env bash
# aide-close-spec — the mechanical steps of the close step:
# resolving the spec argument to a folder, checking whether a merge
# conflict is open, and stamping-and-moving the folder with the reason
# the person closing it typed.
#
# Unlike aide-archive-spec, this carries no not-implemented-yet or
# acceptance-criteria-unticked gate: Close's whole point is to end a
# work round that never reached — or never will reach — those
# milestones. A reason is the one thing it does require
# closing without one is refused before anything is touched.
#
# Called by aide-run-spec as a pre-check before it decides whether to
# spawn the model at all, and again by the skill's Step 1. Idempotent
# the same way aide-archive-spec is: a folder already under archive/
# carrying a **Closed:** stamp is reported as already-closed rather
# than stamped again — the dual-call-site case (aide-run-spec's own
# pre-check, then the skill's Step 1 calling this a second time for the
# same close step).
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, note?, specFolder?}
#
# terminalReason, checked in this order:
#   refused | already-closed | already-archived | conflict-open | closed
#
# Usage:
#   aide-close-spec --project-dir <path> --spec <arg> --reason <text>
#                    [--specs-dir <path>] [--result-file <path>]
#
# --specs-dir names a directory in the specs repo, when that repo is
# separate from the project — checked for an open merge alongside
# --project-dir, and read/written as the resolved specs root when given
# (see aide-archive-spec's own comment on why: a headless run's rebased
# worktree, not the shared unrebased checkout every other command reads).

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Kept in each spec command, not sourced: it runs with nothing loaded, so
# --help answers and a missing library is refused into --result-file.
bootstrap_result_file=""
bootstrap_value=""
for arg in "$@"; do
  if [ -n "$bootstrap_value" ]; then
    [ "$bootstrap_value" = "result" ] && bootstrap_result_file="$arg"
    bootstrap_value=""
    continue
  fi
  case "$arg" in
    -h|--help) printf '%s\n' 'Usage:' \
      '  aide-close-spec --project-dir <path> --spec <arg> --reason <text>' \
      '                   [--specs-dir <path>] [--result-file <path>]'; exit 0 ;;
    --result-file) bootstrap_value="result" ;;
    --project-dir|--spec|--specs-dir|--reason) bootstrap_value="value" ;;
  esac
done
require_library() {
  [ -f "$SCRIPT_DIR/$1" ] && return 0
  payload="$(printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"%s is missing beside aide-close-spec — reinstall aide"}' "$1")"
  printf '%s\n' "$payload"
  [ -z "$bootstrap_result_file" ] || printf '%s\n' "$payload" > "$bootstrap_result_file"
  exit 2
}
for library in _aide-spec-lib.sh lib/config/aide-config.sh lib/spec-result.sh \
  lib/spec-state.sh lib/status-progress.sh lib/spec-transitions.sh \
  lib/spec-reference.sh lib/spec-commands/find-spec.sh; do
  require_library "$library"
done
# shellcheck source=/dev/null
source "$SCRIPT_DIR/_aide-spec-lib.sh"
source "$SCRIPT_DIR/lib/spec-result.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/spec-state.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/spec-transitions.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/spec-reference.sh"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/lib/spec-commands/find-spec.sh"

project_dir=""; spec_arg=""; specs_dir=""; result_file=""; reason=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'USAGE'
Usage:
  aide-close-spec --project-dir <path> --spec <arg> --reason <text>
                   [--specs-dir <path>] [--result-file <path>]
USAGE
      exit 0 ;;
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --specs-dir) specs_dir="${2:-}"; shift 2 ;;
    --reason) reason="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) aide_spec_refuse "unknown argument: $1" ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

# shellcheck source=/dev/null

[ -n "$project_dir" ] || aide_spec_refuse "missing --project-dir"
[ -n "$spec_arg" ] || aide_spec_refuse "missing --spec"
[ -n "$reason" ] || aide_spec_refuse "missing --reason"
[ -d "$project_dir" ] || aide_spec_refuse "no such --project-dir: $project_dir"

aide_spec_command_root "$project_dir" "$specs_dir"

aide_spec_command_folder "$specs_root" "$spec_arg"

# --- already under archive/: closed, or plainly archived --------------------
# Both a closed and an archived spec live under archive/, so the folder
# path alone cannot tell them apart — the **Closed:** stamp does. A
# stamp present is the dual-call-site idempotent case (see the header
# comment); its absence means this folder was archived, not closed, and
# only reopen is legal on it (the queue-level gate already refuses this
# request before it reaches here in the normal path; this is defense in
# depth, not the primary gate).
case "$spec_folder" in
  archive/*)
    folder_name="${spec_folder#archive/}"
    existing_status="$specs_root/$spec_folder/4-status.md"
    # The stamp at the start of a line, as spec-state.sh reads it — a
    # status that merely mentions the stamp in its text is not closed.
    if [ -f "$existing_status" ] && grep -Eq '^[[:space:]]*-?[[:space:]]*\*\*Closed:\*\*' "$existing_status" 2>/dev/null; then
      aide_spec_emit_ok "$(jq -cn --arg n "spec $folder_name is already closed — nothing to do" \
        --arg f "$spec_folder" \
        '{terminalReason:"already-closed", note:$n, specFolder:$f}')"
    fi
    aide_spec_emit_ok "$(jq -cn --arg n "$folder_name is archived — only reopen can be asked for it" \
      --arg f "$spec_folder" \
      '{terminalReason:"already-archived", note:$n, specFolder:$f}')"
    ;;
esac

# --- the conflict check ---------------------------------------------------
# Same check aide-archive-spec makes: a checkout a person left mid-merge
# is not one to stamp and move a folder in. aide-run-spec itself aborts a
# conflicting catch-up for a close, and skips the code branch's.
check_dirs=("$project_dir")
[ -n "$specs_dir" ] && [ -d "$specs_dir" ] && check_dirs+=("$specs_dir")
for dir in "${check_dirs[@]}"; do
  if git -C "$dir" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    aide_spec_emit_ok '{"terminalReason":"conflict-open"}'
  fi
done

# --- closed: stamp and move -------------------------------------------------
# A folder without 4-status.md still moves; it just gets no stamp.
stamp_and_move_spec "$specs_root" "$spec_folder" "closed" "$reason"

aide_spec_emit_ok "$(jq -cn --arg f "archive/$spec_folder" \
  '{terminalReason:"closed", specFolder:$f}')"
