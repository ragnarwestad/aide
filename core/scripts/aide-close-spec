#!/usr/bin/env bash
# aide-close-spec — the mechanical steps of /aide-close (spec 406):
# resolving the spec argument to a folder, checking whether a merge
# conflict is open, and stamping-and-moving the folder with the reason
# the person closing it typed.
#
# Unlike aide-archive-spec, this carries no not-implemented-yet or
# acceptance-criteria-unticked gate: Close's whole point is to end a
# work round that never reached — or never will reach — those
# milestones (REQ-1, REQ-13). A reason is the one thing it does require
# (REQ-3): closing without one is refused before anything is touched.
#
# Callable directly by a person running /aide-close interactively, and
# by aide-run-spec as a pre-check before it decides whether to spawn the
# model at all. Idempotent the same way aide-archive-spec is: a folder
# already under archive/ carrying a **Closed:** stamp is reported as
# already-closed rather than stamped again — the dual-call-site case
# (aide-run-spec's own pre-check, then the skill's Step 1 calling this a
# second time for the same close step).
#
# Prints ONE JSON line to stdout and, if given, to --result-file:
#   {ok, exitCode, terminalReason, error?, note?, specFolder?}
#
# terminalReason, checked in this order:
#   refused | already-closed | already-archived | conflict-open | closed
#
# Usage:
#   aide-close-spec --project-dir <path> --spec <arg> --reason <text>
#                    [--specs-dir <path>] [--result-file <path>]
#
# --specs-dir names a directory in the specs repo, when that repo is
# separate from the project — checked for an open merge alongside
# --project-dir, and read/written as the resolved specs root when given
# (see aide-archive-spec's own comment on why: a headless run's rebased
# worktree, not the shared unrebased checkout every other command reads).

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/_aide-spec-lib.sh" ] && source "$SCRIPT_DIR/_aide-spec-lib.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/spec-state.sh" ] && source "$SCRIPT_DIR/lib/spec-state.sh"
# shellcheck source=/dev/null
[ -f "$SCRIPT_DIR/lib/spec-transitions.sh" ] && source "$SCRIPT_DIR/lib/spec-transitions.sh"

project_dir=""; spec_arg=""; specs_dir=""; result_file=""; reason=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project-dir) project_dir="${2:-}"; shift 2 ;;
    --spec) spec_arg="${2:-}"; shift 2 ;;
    --specs-dir) specs_dir="${2:-}"; shift 2 ;;
    --reason) reason="${2:-}"; shift 2 ;;
    --result-file) result_file="${2:-}"; shift 2 ;;
    *) printf '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"unknown argument: %s"}\n' "$1"; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"exitCode":2,"terminalReason":"refused","error":"jq is required"}'; exit 2; }

refuse() {
  local msg="$1" line
  line="$(jq -cn --arg e "$msg" '{ok:false, exitCode:2, terminalReason:"refused", error:$e}')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 2
}

# One shape for every non-refusal outcome: ok:true, exitCode:0, plus
# whatever fields that outcome adds. $1 is a JSON object literal already
# carrying terminalReason and any extra fields.
emit_ok() {
  local extra="$1" line
  line="$(jq -cn --argjson extra "$extra" '{ok:true, exitCode:0} + $extra')"
  printf '%s\n' "$line"
  [ -n "$result_file" ] && printf '%s\n' "$line" > "$result_file" 2>/dev/null
  exit 0
}

[ -n "$project_dir" ] || refuse "missing --project-dir"
[ -n "$spec_arg" ] || refuse "missing --spec"
[ -n "$reason" ] || refuse "missing --reason"
[ -d "$project_dir" ] || refuse "no such --project-dir: $project_dir"

if [ -n "$specs_dir" ] && [ -d "$specs_dir" ]; then
  specs_root="$specs_dir"
elif declare -f aide_specs_root >/dev/null 2>&1; then
  specs_root="$(aide_specs_root "$project_dir")"
else
  specs_root="$project_dir/specs"
fi
[ -d "$specs_root" ] || refuse "no specs root at $specs_root"

spec_folder=""
if declare -f aide_resolve_spec >/dev/null 2>&1; then
  spec_folder="$(aide_resolve_spec "$spec_arg" "$specs_root")"
fi
# Same fallback aide-archive-spec uses: a spelled-out `NN-slug` that only
# exists under archive/ is looked up there directly.
if [ -n "$spec_folder" ] && [ ! -d "$specs_root/$spec_folder" ]; then
  spec_folder=""
fi
if [ -z "$spec_folder" ] && [ -d "$specs_root/archive" ]; then
  if [ -d "$specs_root/archive/$spec_arg" ]; then
    spec_folder="archive/$spec_arg"
  else
    for candidate in "$specs_root/archive"/*/; do
      base="$(basename "$candidate")"
      case "$base" in "$spec_arg"-*) spec_folder="archive/$base"; break ;; esac
    done
  fi
fi
if [ -z "$spec_folder" ]; then
  active="$(find "$specs_root" -maxdepth 1 -mindepth 1 -type d ! -name archive \
    -exec basename {} \; 2>/dev/null | sort | paste -sd', ' -)"
  refuse "unknown spec: $spec_arg (not under $specs_root)${active:+ — active folders: $active}"
fi

# --- already under archive/: closed, or plainly archived --------------------
# Both a closed and an archived spec live under archive/, so the folder
# path alone cannot tell them apart — the **Closed:** stamp does. A
# stamp present is the dual-call-site idempotent case (see the header
# comment); its absence means this folder was archived, not closed, and
# only reopen is legal on it (the queue-level gate already refuses this
# request before it reaches here in the normal path; this is defense in
# depth, not the primary gate).
case "$spec_folder" in
  archive/*)
    folder_name="${spec_folder#archive/}"
    existing_status="$specs_root/$spec_folder/4-status.md"
    if [ -f "$existing_status" ] && grep -q '\*\*Closed:\*\*' "$existing_status" 2>/dev/null; then
      emit_ok "$(jq -cn --arg n "spec $folder_name is already closed — nothing to do" \
        --arg f "$spec_folder" \
        '{terminalReason:"already-closed", note:$n, specFolder:$f}')"
    fi
    emit_ok "$(jq -cn --arg n "$folder_name is archived — only reopen can be asked for it" \
      --arg f "$spec_folder" \
      '{terminalReason:"already-archived", note:$n, specFolder:$f}')"
    ;;
esac

# --- the conflict check ---------------------------------------------------
# Same check aide-archive-spec makes: aide-run-spec's own
# update_branch_to_base leaves MERGE_HEAD set for a close step rather
# than aborting, so this can be running in a worktree that is mid-merge.
check_dirs=("$project_dir")
[ -n "$specs_dir" ] && [ -d "$specs_dir" ] && check_dirs+=("$specs_dir")
for dir in "${check_dirs[@]}"; do
  if git -C "$dir" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    emit_ok '{"terminalReason":"conflict-open"}'
  fi
done

# --- closed: stamp and move -------------------------------------------------
# spec 356: write_phase_stamp (core/scripts/lib/spec-transitions.sh) is
# the one place the **Closed:** stamp is formatted and written — called
# here rather than through apply_spec_transition because the stamp goes
# onto the OLD (pre-move) path and the state-file mirror below has to
# happen at the NEW (post-move) one, the same two-path reasoning
# aide-archive-spec's own equivalent comment gives.
status_file="$specs_root/$spec_folder/4-status.md"
[ -f "$status_file" ] && write_phase_stamp "$status_file" "closed" "$reason"

mkdir -p "$specs_root/archive"
specs_root_is_git="no"
if git -C "$specs_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  specs_root_is_git="yes"
  git -C "$specs_root" mv "$spec_folder" "archive/$spec_folder"
else
  mv "$specs_root/$spec_folder" "$specs_root/archive/$spec_folder"
fi

# spec 355: re-derives at the NEW (closed) location, so the state file
# travels with the git-mv above and carries the `closed` stamp just
# written into the prose.
if declare -f write_spec_state >/dev/null 2>&1; then
  write_spec_state "$specs_root/archive/$spec_folder/4-status.md"
  [ "$specs_root_is_git" = "yes" ] \
    && git -C "$specs_root" add -- "archive/$spec_folder/4-status.json" 2>/dev/null
fi

emit_ok "$(jq -cn --arg f "archive/$spec_folder" \
  '{terminalReason:"closed", specFolder:$f}')"
