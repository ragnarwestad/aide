{
  "description": "aide hooks for Codex. Installed to ~/.codex/hooks.json. The two command rules are the scripts Claude Code runs too, in ~/.local/bin/lib/command-rules/; the rest are Codex ports of the Claude Code hooks, in ~/.codex/hooks/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "$HOME/.local/bin/lib/command-rules/block-git-add-all.sh",
            "statusMessage": "Checking git add usage"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "$HOME/.local/bin/lib/command-rules/block-watch-mode.sh",
            "statusMessage": "Checking for watch mode"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "$HOME/.codex/hooks/aide-markdownlint.sh",
            "statusMessage": "Linting markdown"
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "$HOME/.codex/hooks/aide-track-turn.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "$HOME/.codex/hooks/aide-track-turn.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/aide-stop-guard.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
