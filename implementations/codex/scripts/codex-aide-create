#!/bin/bash
# codex-aide-create - Create JIRA/TODO documentation via Codex CLI
#
# Usage:
#   codex-aide-create PROJ-7890              # JIRA issue
#   codex-aide-create todo-01-redux-migration   # TODO plan
#   codex-aide-create todo Description here      # TODO with auto-generated slug

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPTS_DIR="$(dirname "$SCRIPT_DIR")/prompts"

if [ -z "$1" ]; then
    echo "Usage: codex-aide-create <ID> [description]"
    echo ""
    echo "Examples:"
    echo "  codex-aide-create PROJ-7890"
    echo "  codex-aide-create todo-01-redux-migration"
    echo "  codex-aide-create todo Description here"
    exit 1
fi

ID="$1"
shift
DESCRIPTION="$*"

# Read prompt template
PROMPT_FILE="$PROMPTS_DIR/aide-create.md"
if [ ! -f "$PROMPT_FILE" ]; then
    echo "Error: Cannot find $PROMPT_FILE"
    exit 1
fi

# Build prompt with ID substitution
if [[ "$ID" == PROJ-* ]]; then
    # JIRA issue
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/PROJ-XXXX/$ID/g")
    PROMPT="$PROMPT

---
Run the task for JIRA issue: $ID"
else
    # TODO plan
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/TODO-XX-navn/$ID/g")
    if [ -n "$DESCRIPTION" ]; then
        PROMPT="$PROMPT

---
Run the task for TODO: $ID
Description: $DESCRIPTION"
    else
        PROMPT="$PROMPT

---
Run the task for TODO: $ID"
    fi
fi

# Run Codex with the prompt
exec codex "$PROMPT"
