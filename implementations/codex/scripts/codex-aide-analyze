#!/bin/bash
# codex-aide-analyze - Analyze codebase for JIRA/TODO via Codex CLI
#
# Usage:
#   codex-aide-analyze PROJ-7890    # JIRA issue
#   codex-aide-analyze todo-01         # TODO plan

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPTS_DIR="$(dirname "$SCRIPT_DIR")/prompts"

if [ -z "$1" ]; then
    echo "Usage: codex-aide-analyze <ID>"
    echo ""
    echo "Examples:"
    echo "  codex-aide-analyze PROJ-7890"
    echo "  codex-aide-analyze todo-01"
    exit 1
fi

ID="$1"

# Read prompt template
PROMPT_FILE="$PROMPTS_DIR/aide-analyze.md"
if [ ! -f "$PROMPT_FILE" ]; then
    echo "Error: Cannot find $PROMPT_FILE"
    exit 1
fi

# Build prompt with ID substitution
if [[ "$ID" == PROJ-* ]]; then
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/PROJ-XXXX/$ID/g")
    PROMPT="$PROMPT

---
Run analysis for JIRA issue: $ID"
else
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/TODO-XX-navn/$ID/g" | sed "s/TODO-XX/$ID/g")
    PROMPT="$PROMPT

---
Run analysis for TODO: $ID"
fi

# Run Codex with the prompt
exec codex "$PROMPT"
