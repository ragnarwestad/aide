#!/bin/bash
# codex-aide-analyze - Analyser kodebase for JIRA/TODO via Codex CLI
#
# Bruk:
#   codex-aide-analyze PROJ-7890    # JIRA-sak
#   codex-aide-analyze todo-01         # TODO-plan

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPTS_DIR="$(dirname "$SCRIPT_DIR")/prompts"

if [ -z "$1" ]; then
    echo "Bruk: codex-aide-analyze <ID>"
    echo ""
    echo "Eksempler:"
    echo "  codex-aide-analyze PROJ-7890"
    echo "  codex-aide-analyze todo-01"
    exit 1
fi

ID="$1"

# Les prompt-template
PROMPT_FILE="$PROMPTS_DIR/aide-analyze.md"
if [ ! -f "$PROMPT_FILE" ]; then
    echo "Feil: Finner ikke $PROMPT_FILE"
    exit 1
fi

# Bygg prompt med ID-substitusjon
if [[ "$ID" == PROJ-* ]]; then
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/PROJ-XXXX/$ID/g")
    PROMPT="$PROMPT

---
Kjør analyse for JIRA-sak: $ID"
else
    PROMPT=$(cat "$PROMPT_FILE" | sed "s/TODO-XX-navn/$ID/g" | sed "s/TODO-XX/$ID/g")
    PROMPT="$PROMPT

---
Kjør analyse for TODO: $ID"
fi

# Kjør Codex med prompten
exec codex "$PROMPT"
