{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: Run all tests",
      "type": "shell",
      "command": "cd ${workspaceFolder}/../my-app && pnpm test -- --run",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Test: Run specific test file",
      "type": "shell",
      "command": "cd ${workspaceFolder}/../my-app && pnpm test -- --run ${input:testFile}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "test"
    },
    {
      "label": "QA: TypeScript check",
      "type": "shell",
      "command": "cd ${workspaceFolder}/../my-app && npx tsc --noEmit",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "QA: ESLint",
      "type": "shell",
      "command": "cd ${workspaceFolder}/../my-app && pnpm run eslint",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "QA: Markdown linting",
      "type": "shell",
      "command": "npx markdownlint-cli2 '**/*.md'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "QA: Full quality check",
      "dependsOn": [
        "QA: TypeScript check",
        "QA: ESLint",
        "QA: Markdown linting",
        "Test: Run all tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Git: Status",
      "type": "shell",
      "command": "git status",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Gemini: Start interactive session",
      "type": "shell",
      "command": "gemini",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "testFile",
      "type": "promptString",
      "description": "Test file path (relative to my-app)"
    }
  ]
}
